# Supabase — both of these ship to the browser, which is fine: the anon key is
# designed to be public and row-level security is what protects the data.
# Never put the service_role key in this file.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, localhost only: skips the password gate while developing.
# import.meta.env.DEV guards its use, so it is stripped from production builds.
PUBLIC_DEV_PASSWORD=your-password
