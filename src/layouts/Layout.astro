---
import "../styles/main.css";
import GitHub from "../components/icons/GitHub.astro";
import LinkedIn from "../components/icons/LinkedIn.astro";
import Mail from "../components/icons/Mail.astro";
import X from "../components/icons/X.astro";
import Sun from "../components/icons/Sun.astro";
import Moon from "../components/icons/Moon.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tanuj Namdeo",
  description = "Tanuj Namdeo — software engineer at Robinhood. Portfolio, work history and projects.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const RESUME_URL =
  "https://drive.google.com/file/d/1a0z_4PMKX9yhtR1hxoiCw6392CR-yBil/view?usp=sharing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />

    <!-- Link previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set the theme before first paint so there's no flash of the wrong one. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        if (stored !== "light") document.documentElement.dataset.theme = "dark";
      })();
    </script>
  </head>

  <body>
    <div class="container">
      <div class="content">
        <header>
          <div class="main"><a href="/">Tanuj Namdeo</a></div>
          <nav class="social-row">
            <a
              href="https://github.com/tanujn45"
              title="GitHub"
              target="_blank"
              rel="noreferrer"><GitHub /></a
            >
            <a
              href="https://linkedin.com/in/tanujn45"
              title="LinkedIn"
              target="_blank"
              rel="noreferrer"><LinkedIn /></a
            >
            <a
              href="https://x.com/tanujn45"
              title="X"
              target="_blank"
              rel="noreferrer"><X /></a
            >
            <span class="sep">|</span>
            <button id="theme-toggle" type="button" aria-label="Toggle theme">
              <Sun />
              <Moon />
            </button>
          </nav>
        </header>

        <slot />

        <footer>
          <!--
            A flex row: whitespace-only text between flex children generates no
            box, so the gaps come from `gap` alone and markup indentation can't
            leak stray spaces the way it does in normal inline flow.
          -->
          <div class="footer-row">
            <a
              href="https://github.com/tanujn45"
              title="GitHub"
              target="_blank"
              rel="noreferrer"><GitHub /></a
            >
            <span class="sep">|</span>
            <a
              href="https://linkedin.com/in/tanujn45"
              title="LinkedIn"
              target="_blank"
              rel="noreferrer"><LinkedIn /></a
            >
            <span class="sep">|</span>
            <a
              href="https://x.com/tanujn45"
              title="X"
              target="_blank"
              rel="noreferrer"><X /></a
            >
            <span class="sep">|</span>
            <a href="mailto:tanujn45@gmail.com" title="Mail"><Mail /></a>
            <span class="sep">|</span>
            <span class="footer-copy">⚡️ {year} © Tanuj</span>
            <span class="sep">|</span>
            <a href={RESUME_URL} target="_blank" rel="noreferrer">Resume</a>
          </div>
        </footer>
      </div>
    </div>

    <!-- Konami cat: up up down down left right left right B A -->
    <div id="konami-cat" class="konami-cat" hidden>
      <figure>
        <img src="/img/cat.png" alt="A deeply unimpressed cat" />
        <figcaption>you found the cat. click anywhere to dismiss.</figcaption>
      </figure>
    </div>

    <script>
      // ---- Theme toggle (persisted) ----
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");

      toggle?.addEventListener("click", () => {
        const isDark = root.dataset.theme === "dark";
        if (isDark) {
          delete root.dataset.theme;
        } else {
          root.dataset.theme = "dark";
        }
        try {
          localStorage.setItem("theme", isDark ? "light" : "dark");
        } catch (e) {
          /* private browsing — the toggle still works for this page */
        }
      });

      // ---- Konami code ----
      const SEQUENCE = [
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
        "b",
        "a",
      ];
      const overlay = document.getElementById("konami-cat");
      let progress = 0;

      const hideCat = () => overlay && (overlay.hidden = true);

      window.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement | null;
        // Don't swallow typing in a field, if one is ever added.
        if (
          target &&
          (target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.isContentEditable)
        ) {
          return;
        }

        if (e.key === "Escape") return hideCat();

        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;

        if (key === SEQUENCE[progress]) {
          progress += 1;
          if (progress === SEQUENCE.length) {
            progress = 0;
            if (overlay) overlay.hidden = false;
          }
        } else {
          // A wrong key can still start a fresh attempt.
          progress = key === SEQUENCE[0] ? 1 : 0;
        }
      });

      overlay?.addEventListener("click", hideCat);

      // ---- For anyone who opens devtools ----
      const art = `
 _____                  _
|_   _|_ _ _ __  _   _ (_)
  | |/ _\` | '_ \\| | | || |
  | | (_| | | | | |_| || |
  |_|\\__,_|_| |_|\\__,_|/ |
                     |__/
`;
      const accent = "color:#50fa7b; font-family:monospace;";
      const plain = "color:#888; font-family:monospace;";
      console.log(`%c${art}`, accent);
      console.log(
        "%cSince you're already in here — the Konami code works on this page.",
        plain
      );
      console.log("%c↑ ↑ ↓ ↓ ← → ← → B A", accent);
      console.log("%cSource: https://github.com/tanujn45/tanujnamdeo.me", plain);
    </script>
  </body>
</html>
