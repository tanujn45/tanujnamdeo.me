---
import Layout from "../layouts/Layout.astro";

const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];
---

<Layout title="Lift" description="Private workout log." noindex bare>
  <main class="lift">
    <section id="unconfigured" hidden>
      <h1>Lift</h1>
      <pre class="terminal"><span class="prompt">$</span> lift
error: Supabase credentials not set</pre>
    </section>

    <section id="auth" hidden>
      <h1>Lift</h1>
      <form id="auth-form" class="stack">
        <input type="password" id="password" placeholder="Password" required
          autocomplete="current-password" />
        <button type="submit" class="btn btn-primary">Unlock</button>
      </form>
      <p id="auth-msg" class="description" role="status"></p>
    </section>

    <!-- ============ HOME: pick a day ============ -->
    <section id="view-home" class="view" hidden>
      <h1>Lift</h1>
      <div class="day-grid">
        {DAYS.map((d) => (
          <button class="btn day-btn" type="button" data-day={d}>{d}</button>
        ))}
      </div>
      <section class="consistency">
        <div class="cal-head">
          <button id="cal-prev" class="cal-nav" type="button" aria-label="Previous month">←</button>
          <strong id="cal-title">—</strong>
          <button id="cal-next" class="cal-nav" type="button" aria-label="Next month">→</button>
        </div>
        <div class="cal-dow">
          <span>M</span><span>T</span><span>W</span><span>T</span>
          <span>F</span><span>S</span><span>S</span>
        </div>
        <div id="cal" class="cal-grid"></div>
        <p id="cal-note" class="muted"></p>
        <div id="cal-day"></div>
      </section>

      <p class="muted">
        <button id="signout" class="linkish" type="button">Sign out</button>
      </p>
    </section>

    <!-- ============ SESSION ============ -->
    <section id="view-session" class="view" hidden>
      <div class="session-head">
        <div>
          <h1 id="session-day">Day</h1>
          <time id="timer">0:00</time>
        </div>
        <button id="finish" class="btn" type="button">Finish</button>
      </div>

      <div id="finish-panel" class="finish-panel" hidden>
        <p id="finish-summary" class="muted"></p>
        <div class="finish-actions">
          <button id="finish-save" class="btn btn-primary" type="button">Save workout</button>
          <button id="finish-discard" class="btn btn-danger" type="button">Discard</button>
          <button id="finish-cancel" class="linkish" type="button">Keep going</button>
        </div>
      </div>

      <div id="exercise-list"></div>

      <button id="open-picker" class="btn btn-wide" type="button">
        + Add exercise
      </button>
      <p id="session-msg" class="description" role="status"></p>
    </section>

    <!-- ============ HISTORY ============ -->
    <section id="view-history" class="view" hidden>
      <h1>History</h1>
      <div id="history-list"></div>
    </section>

    <!-- ============ ONE PAST WORKOUT ============ -->
    <section id="view-workout" class="view" hidden>
      <button id="back-to-history" class="linkish" type="button">← History</button>
      <h1 id="workout-title">Workout</h1>
      <p id="workout-meta" class="muted"></p>
      <div id="workout-detail"></div>
    </section>

    <!-- ============ PROGRESS ============ -->
    <section id="view-progress" class="view" hidden>
      <h1>Progress</h1>

      <h2>Overall</h2>
      <select id="overall-metric" class="wide">
        <option value="volume">Volume per session</option>
        <option value="sets">Sets per session</option>
        <option value="weekly">Sessions per week</option>
      </select>
      <canvas id="overall-chart" height="200"></canvas>
      <p id="overall-msg" class="muted"></p>

      <h2>By exercise</h2>
      <select id="progress-exercise" class="wide">
        <option value="">Choose an exercise…</option>
      </select>
      <select id="progress-metric" class="wide">
        <option value="e1rm">Estimated 1RM</option>
        <option value="top">Heaviest set</option>
        <option value="volume">Total volume</option>
      </select>
      <canvas id="progress-chart" height="220"></canvas>
      <p id="progress-msg" class="muted"></p>
      <div id="progress-table"></div>
    </section>

    <!-- ============ EXERCISE PICKER (sheet) ============ -->
    <div id="picker" class="sheet" hidden>
      <div class="sheet-inner">
        <div class="sheet-head">
          <strong>Add exercise</strong>
          <button id="picker-close" class="linkish" type="button">Close</button>
        </div>
        <div id="picker-list" class="picker-list"></div>
        <form id="new-exercise-form" class="stack sheet-new">
          <input type="text" id="new-ex-name" placeholder="New exercise name" />
          <select id="new-ex-day">
            {DAYS.map((d) => <option value={d}>{d}</option>)}
          </select>
          <button type="submit" class="btn btn-primary">Create &amp; add</button>
        </form>
        <p id="picker-msg" class="description" role="status"></p>
      </div>
    </div>

    <!-- ============ TABS ============ -->
    <nav id="tabs" class="tabbar" hidden>
      <button class="tab" data-view="home" type="button">Workout</button>
      <button class="tab" data-view="history" type="button">History</button>
      <button class="tab" data-view="progress" type="button">Progress</button>
    </nav>
  </main>
</Layout>

<script>
  import { supabase, isConfigured } from "../lib/supabase";
  import Chart from "chart.js/auto";

  const ACCOUNT_EMAIL = "tanujn45@gmail.com";
  const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];

  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on = true) => ((<any>$(id)).hidden = !on);
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
    );

  type Exercise = { id: string; name: string; day: string; archived: boolean };
  type Workout = { id: string; day: string; started_at: string; ended_at: string | null };
  type SetRow = {
    id: string; workout_id: string; exercise_id: string; set_number: number;
    weight: number; unit: "lbs" | "kg"; reps: number; performed_at: string;
  };

  let userId: string | null = null;
  let exercises: Exercise[] = [];
  let allSets: SetRow[] = [];
  let workouts: Workout[] = [];
  let current: Workout | null = null;
  let sessionExercises: string[] = [];
  let timerHandle: number | null = null;
  let editing: string | null = null;      // set id being edited
  let discardArmed = false;
  let calMonth: Date | null = null;   // first day of the month on screen
  let removeArmed: string | null = null;
  let progressChart: Chart | null = null;
  let overallChart: Chart | null = null;

  function withTimeout<T>(p: PromiseLike<T>, ms = 10000): Promise<T> {
    return Promise.race([
      p as Promise<T>,
      new Promise<T>((_, reject) =>
        setTimeout(() => reject(new Error("timed out talking to the database")), ms)
      ),
    ]);
  }

  const say = (m: string) => ($("session-msg").textContent = m);
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;

  // Charts should use the site's own accent rather than a colour of their own.
  const accent = () =>
    getComputedStyle(document.documentElement).getPropertyValue("--maincolor").trim() || "red";
  const accentFill = (a: number) => {
    const c = accent();
    // Named colours cannot take an alpha suffix, so paint through a canvas.
    const cv = document.createElement("canvas").getContext("2d")!;
    cv.fillStyle = c;
    const hex = cv.fillStyle as string;
    if (!hex.startsWith("#")) return c;
    const n = parseInt(hex.slice(1), 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
  };
  const e1rm = (w: number, r: number) => w * (1 + r / 30);
  // Local date, not UTC: toISOString() would push an evening Pacific workout
  // onto the next calendar day and group it wrongly on the chart.
  const dayKey = (iso: string) => {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  };

  // Format a YYYY-MM-DD key without letting Date parse it as UTC midnight.
  const fmtDayKey = (key: string) => {
    const [y, m, d] = key.split("-").map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, {
      weekday: "short", month: "short", day: "numeric",
    });
  };
  const nameOf = (id: string) => exercises.find((e) => e.id === id)?.name ?? "—";
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString(undefined, {
      weekday: "short", month: "short", day: "numeric", year: "numeric",
    });

  if (!isConfigured) show("unconfigured");
  else main().catch((err) => { show("auth"); $("auth-msg").textContent = `Error: ${err.message}`; });

  async function main() {
    const { data } = await supabase.auth.getSession();

    if (!data.session && import.meta.env.DEV && import.meta.env.PUBLIC_DEV_PASSWORD) {
      const { data: dev } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL,
        password: import.meta.env.PUBLIC_DEV_PASSWORD,
      });
      if (dev.user) { await afterSignIn(dev.user.id); wire(); return; }
    }

    if (data.session) await afterSignIn(data.session.user.id);
    else show("auth");

    // Never call supabase from inside this callback: it holds a lock and
    // every query awaits getSession(), which deadlocks.
    supabase.auth.onAuthStateChange((_e, session) => {
      if (!session || userId) return;
      setTimeout(() => afterSignIn(session.user.id), 0);
    });

    wire();
  }

  function wire() {
    $("auth-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = <HTMLInputElement>$("password");
      $("auth-msg").textContent = "Checking…";
      const { data, error } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL, password: f.value,
      });
      f.value = "";
      if (error) {
        $("auth-msg").textContent =
          error.message === "Invalid login credentials" ? "Wrong password." : `Error: ${error.message}`;
        f.focus();
        return;
      }
      $("auth-msg").textContent = "";
      if (data.user) await afterSignIn(data.user.id);
    });

    $("signout").addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>(".day-btn").forEach((b) =>
      b.addEventListener("click", () => startWorkout(b.dataset.day!))
    );
    document.querySelectorAll<HTMLButtonElement>(".tab").forEach((b) =>
      b.addEventListener("click", () => goto(b.dataset.view!))
    );

    $("finish").addEventListener("click", openFinishPanel);
    $("finish-cancel").addEventListener("click", closeFinishPanel);
    $("finish-save").addEventListener("click", () => { closeFinishPanel(); finishWorkout(); });
    $("finish-discard").addEventListener("click", onDiscard);

    $("open-picker").addEventListener("click", openPicker);
    $("picker-close").addEventListener("click", () => show("picker", false));
    $("new-exercise-form").addEventListener("submit", onNewExercise);
    $("back-to-history").addEventListener("click", () => goto("history"));
    $("overall-metric").addEventListener("change", renderOverall);
    $("cal-prev").addEventListener("click", () => stepMonth(-1));
    $("cal-next").addEventListener("click", () => stepMonth(1));
    $("progress-exercise").addEventListener("change", renderProgress);
    $("progress-metric").addEventListener("change", renderProgress);
  }

  // ---------------------------------------------------------------- loading
  async function afterSignIn(id: string) {
    if (userId === id) return;
    userId = id;
    show("auth", false);

    const [ex, wo, st] = await Promise.all([
      supabase.from("exercises").select("id,name,day,archived").order("name"),
      supabase.from("workouts").select("id,day,started_at,ended_at")
        .order("started_at", { ascending: false }).limit(300),
      supabase.from("sets")
        .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at")
        .order("performed_at", { ascending: false }).limit(5000),
    ]);

    const bad = ex.error ?? wo.error ?? st.error;
    if (bad) { goto("home"); say(`Could not load: ${bad.message}`); return; }

    exercises = (ex.data ?? []) as Exercise[];
    workouts = (wo.data ?? []) as Workout[];
    allSets = (st.data ?? []) as SetRow[];

    show("tabs");
    const open = workouts.find((w) => !w.ended_at);
    if (open) await enterSession(open);
    else goto("home");
  }

  // ------------------------------------------------------------------ views
  function goto(view: string) {
    for (const v of ["home", "session", "history", "workout", "progress"])
      show(`view-${v}`, false);
    show("picker", false);

    document.querySelectorAll<HTMLButtonElement>(".tab").forEach((b) =>
      b.classList.toggle("tab-on", b.dataset.view === view ||
        (view === "session" && b.dataset.view === "home") ||
        (view === "workout" && b.dataset.view === "history"))
    );

    if (view === "home") {
      // An open session owns the Workout tab.
      if (current) { show("view-session"); return; }
      show("view-home");
      renderCalendar();
    } else if (view === "session") {
      show("view-session");
    } else if (view === "history") {
      show("view-history");
      renderHistory();
    } else if (view === "progress") {
      show("view-progress");
      renderOverall();
      renderProgressPicker();
      renderProgress();
    } else if (view === "workout") {
      show("view-workout");
    }
  }

  // --------------------------------------------------------------- lifecycle
  async function startWorkout(day: string) {
    if (!DAYS.includes(day)) return;
    const { data, error } = await withTimeout(
      supabase.from("workouts").insert({ day, user_id: userId })
        .select("id,day,started_at,ended_at").single()
    );
    if (error) { say(`Could not start: ${error.message}`); return; }
    const w = data as Workout;
    workouts.unshift(w);

    const forDay = exercises.filter((e) => e.day === day && !e.archived);
    if (forDay.length) {
      await supabase.from("workout_exercises").insert(
        forDay.map((e, i) => ({
          user_id: userId, workout_id: w.id, exercise_id: e.id, position: i,
        }))
      );
    }
    await enterSession(w);
  }

  async function enterSession(w: Workout) {
    current = w;
    $("session-day").textContent = w.day;
    const { data, error } = await supabase.from("workout_exercises")
      .select("exercise_id,position").eq("workout_id", w.id).order("position");
    if (error) { say(`Could not load exercises: ${error.message}`); return; }
    sessionExercises = (data ?? []).map((r: any) => r.exercise_id);
    startTimer();
    goto("session");
    renderSession();
  }

  function openFinishPanel() {
    if (!current) return;
    discardArmed = false;
    const rows = allSets.filter((x) => x.workout_id === current!.id);
    const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
    const mins = Math.round((Date.now() - +new Date(current.started_at)) / 60000);
    $("finish-summary").textContent =
      `${plural(rows.length, "set")} · ${vol} vol · ${mins} min`;
    const d = $("finish-discard");
    d.textContent = rows.length ? `Discard ${rows.length}` : "Discard";
    d.classList.remove("armed");
    show("finish-panel");
  }

  function closeFinishPanel() {
    discardArmed = false;
    show("finish-panel", false);
  }

  // Discarding deletes the sets, so ask twice when there is something to lose.
  function onDiscard() {
    if (!current) return;
    const rows = allSets.filter((x) => x.workout_id === current!.id);
    const d = $("finish-discard");
    if (rows.length && !discardArmed) {
      discardArmed = true;
      d.textContent = "Tap again to delete";
      d.classList.add("armed");
      setTimeout(() => {
        if (!discardArmed) return;
        discardArmed = false;
        d.textContent = `Discard ${rows.length}`;
        d.classList.remove("armed");
      }, 4000);
      return;
    }
    discardArmed = false;
    discardWorkout();
  }

  async function discardWorkout() {
    if (!current) return;
    const id = current.id;
    // sets and workout_exercises cascade from the workout row.
    const { error } = await withTimeout(
      supabase.from("workouts").delete().eq("id", id)
    );
    if (error) { say(`Could not discard: ${error.message}`); return; }
    workouts = workouts.filter((w) => w.id !== id);
    allSets = allSets.filter((x) => x.workout_id !== id);
    current = null;
    stopTimer();
    closeFinishPanel();
    goto("home");
  }

  async function finishWorkout() {
    if (!current) return;
    const { error } = await withTimeout(
      supabase.from("workouts").update({ ended_at: new Date().toISOString() })
        .eq("id", current.id)
    );
    if (error) { say(`Could not finish: ${error.message}`); return; }
    const w = workouts.find((x) => x.id === current!.id);
    if (w) w.ended_at = new Date().toISOString();
    current = null;
    stopTimer();
    goto("home");
  }

  function startTimer() {
    stopTimer();
    const tick = () => {
      if (!current) return;
      const t = Math.max(0, Math.floor((Date.now() - new Date(current.started_at).getTime()) / 1000));
      const h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
      $("timer").textContent = h
        ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
        : `${m}:${String(s).padStart(2, "0")}`;
    };
    tick();
    timerHandle = window.setInterval(tick, 1000);
  }
  function stopTimer() { if (timerHandle) clearInterval(timerHandle); timerHandle = null; }

  // ------------------------------------------------------------ the picker
  // Shows the WHOLE library grouped by day. Things already in the session are
  // shown greyed out rather than hidden, which is what made this confusing.
  function openPicker() {
    show("picker");
    ($("new-ex-day") as HTMLSelectElement).value = current?.day ?? "Chest";
    renderPickerList();
  }

  function renderPickerList() {
    const host = $("picker-list");
    const live = exercises.filter((e) => !e.archived);
    if (!live.length) {
      host.innerHTML = '<p class="muted">No exercises yet. Create one below.</p>';
      return;
    }
    host.innerHTML = DAYS.map((d) => {
      const inDay = live.filter((e) => e.day === d);
      if (!inDay.length) return "";
      return `<div class="picker-group"><h3>${d}</h3>${inDay
        .map((e) => {
          const already = sessionExercises.includes(e.id);
          return `<button type="button" class="picker-item${already ? " picker-item-on" : ""}"
            data-ex="${e.id}"${already ? " disabled" : ""}>
            ${esc(e.name)}${already ? "<span class=\"tag\">in session</span>" : ""}
          </button>`;
        })
        .join("")}</div>`;
    }).join("");

    host.querySelectorAll<HTMLButtonElement>(".picker-item:not([disabled])").forEach((b) =>
      b.addEventListener("click", () => addToSession(b.dataset.ex!))
    );
  }

  async function addToSession(id: string) {
    if (!current) return;
    const { error } = await withTimeout(
      supabase.from("workout_exercises").insert({
        user_id: userId, workout_id: current.id, exercise_id: id,
        position: sessionExercises.length,
      })
    );
    if (error) { $("picker-msg").textContent = `Could not add: ${error.message}`; return; }
    sessionExercises.push(id);
    $("picker-msg").textContent = "";
    renderPickerList();
    renderSession();
  }

  async function onNewExercise(e: Event) {
    e.preventDefault();
    const field = <HTMLInputElement>$("new-ex-name");
    const name = field.value.trim();
    if (!name || !current) return;
    const day = (<HTMLSelectElement>$("new-ex-day")).value;

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase.from("exercises").insert({ name, day, user_id: userId })
          .select("id,name,day,archived").single()
      ));
    } catch (err) {
      $("picker-msg").textContent = `Error: ${(err as Error).message}`;
      return;
    }
    if (error) {
      $("picker-msg").textContent = error.message.includes("duplicate")
        ? `"${name}" already exists.` : `Error: ${error.message}`;
      return;
    }
    field.value = "";
    exercises.push(data as Exercise);
    exercises.sort((a, b) => a.name.localeCompare(b.name));
    await addToSession(data.id);
  }

  async function removeExercise(exId: string) {
    if (!current) return;
    const logged = allSets.filter((s) => s.workout_id === current!.id && s.exercise_id === exId);

    // Removing something with sets deletes those sets, so make it two taps.
    if (logged.length && removeArmed !== exId) {
      removeArmed = exId;
      renderSession();
      setTimeout(() => {
        if (removeArmed !== exId) return;
        removeArmed = null;
        renderSession();
      }, 4000);
      return;
    }
    removeArmed = null;

    if (logged.length) {
      const { error } = await supabase.from("sets").delete()
        .eq("workout_id", current.id).eq("exercise_id", exId);
      if (error) { say(`Could not remove: ${error.message}`); return; }
      allSets = allSets.filter((s) => !(s.workout_id === current!.id && s.exercise_id === exId));
    }
    const { error } = await supabase.from("workout_exercises").delete()
      .eq("workout_id", current.id).eq("exercise_id", exId);
    if (error) { say(`Could not remove: ${error.message}`); return; }
    sessionExercises = sessionExercises.filter((i) => i !== exId);
    renderSession();
  }

  // ------------------------------------------------------------------- PRs
  // A personal record is a set whose estimated 1RM beats every earlier set of
  // the same exercise, so more reps at the same weight counts too. Weights are
  // normalised to lbs first, otherwise switching units would fake a record.
  // The very first set of an exercise is not a PR: there is nothing to beat.
  const toLbs = (w: number, unit: string) => (unit === "kg" ? w * 2.20462 : w);

  function isPR(set: SetRow): boolean {
    const earlier = allSets.filter(
      (s) =>
        s.exercise_id === set.exercise_id &&
        s.id !== set.id &&
        new Date(s.performed_at) < new Date(set.performed_at)
    );
    if (!earlier.length) return false;
    const best = Math.max(...earlier.map((s) => e1rm(toLbs(s.weight, s.unit), s.reps)));
    return e1rm(toLbs(set.weight, set.unit), set.reps) > best + 1e-9;
  }

  const CAT = '<img class="pr-cat" src="/img/cat.png" alt="PR" title="Personal record" />';

  // -------------------------------------------------- last time, same slot
  function lastTime(exId: string, n: number): SetRow | null {
    return allSets
      .filter((s) => s.exercise_id === exId && s.workout_id !== current?.id && s.set_number === n)
      .sort((a, b) => +new Date(b.performed_at) - +new Date(a.performed_at))[0] ?? null;
  }

  // ------------------------------------------------------------- session UI
  function renderSession() {
    if (!current) return;
    const host = $("exercise-list");
    if (!sessionExercises.length) {
      host.innerHTML = '<p class="muted">Nothing here yet — add an exercise below.</p>';
      return;
    }

    host.innerHTML = sessionExercises.map((exId) => {
      const ex = exercises.find((e) => e.id === exId);
      if (!ex) return "";
      const done = allSets
        .filter((s) => s.workout_id === current!.id && s.exercise_id === exId)
        .sort((a, b) => a.set_number - b.set_number);
      const next = done.length + 1;
      const prev = lastTime(exId, next);
      const unit = done.at(-1)?.unit ?? localStorage.getItem("lift:unit") ?? "lbs";

      const rows = done.map((s) => {
        if (editing === s.id) {
          return `<li class="set-row set-editing" data-set="${s.id}">
            <div class="ed-grid">
              <label><span>Weight</span>
                <input type="number" class="ed-weight" value="${s.weight}" step="0.5" min="0" inputmode="decimal" /></label>
              <label><span>Reps</span>
                <input type="number" class="ed-reps" value="${s.reps}" step="1" min="1" inputmode="numeric" /></label>
            </div>
            <div class="ed-actions">
              <button type="button" class="btn btn-sm save-set" data-set="${s.id}">Save set ${s.set_number}</button>
              <button type="button" class="btn btn-sm cancel-set">Cancel</button>
            </div>
          </li>`;
        }
        const was = lastTime(exId, s.set_number);
        const d = was ? s.weight - was.weight : null;
        const arrow = d === null || d === 0 ? "" : d > 0 ? " ▲" : " ▼";
        return `<li class="set-row" data-set="${s.id}">
          <button type="button" class="set-main edit-set" data-set="${s.id}">
            <span class="set-n">${s.set_number}</span>
            <span class="set-val">${s.weight}${s.unit} × ${s.reps}${arrow}${isPR(s) ? CAT : ""}</span>
            ${was ? `<span class="was">was ${was.weight}${was.unit} × ${was.reps}</span>` : ""}
          </button>
          <button type="button" class="icon-btn del-set" data-set="${s.id}" aria-label="Delete set">×</button>
        </li>`;
      }).join("");

      return `<section class="ex-card" data-ex="${exId}">
        <header class="ex-head">
          <h2>${esc(ex.name)}</h2>
          <button type="button" class="linkish remove-ex${removeArmed === exId ? " armed" : ""}" data-ex="${exId}">${
            removeArmed === exId ? `delete ${done.length} set(s)?` : "remove"
          }</button>
        </header>
        <ul class="set-list">${rows}</ul>
        <p class="hint">${prev
          ? `Set ${next} last time: <strong>${prev.weight}${prev.unit} × ${prev.reps}</strong>`
          : `No set ${next} on record yet.`}</p>
        <form class="log-form" data-ex="${exId}">
          <div class="log-inputs">
            <label><span>Weight</span>
              <input type="number" class="in-weight" inputmode="decimal" step="0.5" min="0" required /></label>
            <label><span>Reps</span>
              <input type="number" class="in-reps" inputmode="numeric" step="1" min="1" required /></label>
            <label><span>Unit</span>
              <select class="in-unit">
                <option value="lbs"${unit === "lbs" ? " selected" : ""}>lbs</option>
                <option value="kg"${unit === "kg" ? " selected" : ""}>kg</option>
              </select></label>
          </div>
          <button type="submit" class="btn btn-primary btn-wide">Log set ${next}</button>
        </form>
      </section>`;
    }).join("");

    host.querySelectorAll<HTMLFormElement>(".log-form").forEach((f) =>
      f.addEventListener("submit", onLogSet));
    host.querySelectorAll<HTMLButtonElement>(".remove-ex").forEach((b) =>
      b.addEventListener("click", () => removeExercise(b.dataset.ex!)));
    host.querySelectorAll<HTMLButtonElement>(".del-set").forEach((b) =>
      b.addEventListener("click", () => deleteSet(b.dataset.set!)));
    host.querySelectorAll<HTMLButtonElement>(".edit-set").forEach((b) =>
      b.addEventListener("click", () => { editing = b.dataset.set!; renderSession(); }));
    host.querySelectorAll<HTMLButtonElement>(".save-set").forEach((b) =>
      b.addEventListener("click", () => saveSet(b.dataset.set!)));
    host.querySelectorAll<HTMLButtonElement>(".cancel-set").forEach((b) =>
      b.addEventListener("click", () => { editing = null; renderSession(); }));
  }

  async function onLogSet(e: Event) {
    e.preventDefault();
    const form = <HTMLFormElement>e.currentTarget;
    const exId = form.dataset.ex!;
    if (!current) return;
    const weight = parseFloat((<HTMLInputElement>form.querySelector(".in-weight")).value);
    const reps = parseInt((<HTMLInputElement>form.querySelector(".in-reps")).value, 10);
    const unit = <"lbs" | "kg">(<HTMLSelectElement>form.querySelector(".in-unit")).value;
    const n = allSets.filter((s) => s.workout_id === current!.id && s.exercise_id === exId).length + 1;

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase.from("sets").insert({
          user_id: userId, workout_id: current.id, exercise_id: exId,
          set_number: n, weight, reps, unit,
        }).select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at").single()
      ));
    } catch (err) { say(`Error: ${(err as Error).message}`); return; }
    if (error) { say(`Error: ${error.message}`); return; }

    allSets.unshift(data as SetRow);
    localStorage.setItem("lift:unit", unit);
    say("");
    renderSession();
  }

  async function saveSet(id: string) {
    const li = document.querySelector(`.set-row[data-set="${id}"]`);
    if (!li) return;
    const weight = parseFloat((<HTMLInputElement>li.querySelector(".ed-weight")).value);
    const reps = parseInt((<HTMLInputElement>li.querySelector(".ed-reps")).value, 10);
    if (!(weight >= 0) || !(reps > 0)) { say("Weight and reps must be numbers."); return; }

    const { data, error } = await withTimeout(
      supabase.from("sets").update({ weight, reps }).eq("id", id)
        .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at").single()
    );
    if (error) { say(`Could not save: ${error.message}`); return; }
    const i = allSets.findIndex((s) => s.id === id);
    if (i >= 0) allSets[i] = data as SetRow;
    editing = null;
    say("");
    renderSession();
  }

  async function deleteSet(id: string) {
    const { error } = await withTimeout(supabase.from("sets").delete().eq("id", id));
    if (error) { say(`Could not delete: ${error.message}`); return; }
    allSets = allSets.filter((s) => s.id !== id);
    renderSession();
  }

  // ---------------------------------------------------------- consistency
  // Same block characters the old WakaTime tracker used: light shade for a
  // rest day, medium for a session, full for a long one.
  const keyOf = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

  // Tapping a day lists everything done that day, so several sessions on one
  // date are all reachable instead of only the newest.
  function showDay(key: string, onDay: Workout[]) {
    const withSets = onDay.filter((w) => allSets.some((s) => s.workout_id === w.id));
    if (!withSets.length) { $("cal-day").innerHTML = ""; return; }

    $("cal-day").innerHTML =
      `<p class="muted cal-day-title">${fmtDayKey(key)}</p>` +
      withSets
        .sort((a, b) => +new Date(a.started_at) - +new Date(b.started_at))
        .map((w) => {
          const rows = allSets.filter((s) => s.workout_id === w.id);
          const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
          const time = new Date(w.started_at).toLocaleTimeString(undefined, {
            hour: "numeric", minute: "2-digit",
          });
          return `<button type="button" class="hist-row" data-w="${w.id}">
            <span class="hist-day">${esc(w.day)}</span>
            <span class="hist-meta">${time} · ${plural(rows.length, "set")} · ${vol} vol</span>
          </button>`;
        })
        .join("");

    $("cal-day").querySelectorAll<HTMLButtonElement>("button[data-w]").forEach((b) =>
      b.addEventListener("click", () => openWorkout(b.dataset.w!))
    );
  }

  function stepMonth(delta: number) {
    if (!calMonth) return;
    const next = new Date(calMonth.getFullYear(), calMonth.getMonth() + delta, 1);
    const thisMonth = new Date();
    // Nothing to see in the future.
    if (next > new Date(thisMonth.getFullYear(), thisMonth.getMonth(), 1)) return;
    calMonth = next;
    renderCalendar();
  }

  function renderCalendar() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (!calMonth) calMonth = new Date(today.getFullYear(), today.getMonth(), 1);

    const year = calMonth.getFullYear();
    const month = calMonth.getMonth();

    $("cal-title").textContent = calMonth.toLocaleDateString(undefined, {
      month: "long", year: "numeric",
    });

    // Sets per day, and the workout to open when a day is tapped.
    const counts = new Map<string, number>();
    for (const st of allSets) {
      const k = dayKey(st.performed_at);
      counts.set(k, (counts.get(k) ?? 0) + 1);
    }
    // A day can hold several workouts; keep them all, not just the last.
    const workoutsOn = new Map<string, Workout[]>();
    for (const w of workouts) {
      const k = dayKey(w.started_at);
      if (!workoutsOn.has(k)) workoutsOn.set(k, []);
      workoutsOn.get(k)!.push(w);
    }

    const first = new Date(year, month, 1);
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    // Monday-first, so Sunday (0) becomes 6.
    const lead = (first.getDay() + 6) % 7;

    let html = "";
    for (let i = 0; i < lead; i++) html += '<span class="cal-cell cal-blank"></span>';

    let trained = 0;
    let sets = 0;
    for (let d = 1; d <= daysInMonth; d++) {
      const date = new Date(year, month, d);
      const key = keyOf(date);
      const n = counts.get(key) ?? 0;
      const future = date > today;
      const isToday = keyOf(today) === key;
      const mark = future ? " " : n === 0 ? "░" : n >= 6 ? "█" : "▓";
      if (n > 0) { trained++; sets += n; }

      const onDay = (workoutsOn.get(key) ?? []).filter(
        (w) => allSets.some((x) => x.workout_id === w.id)
      );
      const cls = ["cal-cell"];
      if (n > 0) cls.push("cal-on");
      if (isToday) cls.push("cal-today");
      if (future) cls.push("cal-future");

      // Show the set count rather than a bare block: far more to read at a
      // glance, and it makes a busy month look busy.
      const body = `<span class="cal-d">${d}</span>` +
        (n > 0
          ? `<span class="cal-m">${mark}</span><span class="cal-n">${n}</span>` +
            (onDay.length > 1 ? `<span class="cal-multi">${onDay.length}×</span>` : "")
          : `<span class="cal-m">${mark}</span>`);

      html += onDay.length
        ? `<button type="button" class="${cls.join(" ")}" data-day="${key}">${body}</button>`
        : `<span class="${cls.join(" ")}">${body}</span>`;
    }

    $("cal").innerHTML = html;
    $("cal-note").textContent = trained
      ? `${plural(trained, "day")} · ${plural(sets, "set")} this month`
      : "Nothing logged this month.";

    $("cal").querySelectorAll<HTMLButtonElement>("button[data-day]").forEach((b) =>
      b.addEventListener("click", () => showDay(b.dataset.day!, workoutsOn.get(b.dataset.day!) ?? []))
    );
    $("cal-day").innerHTML = "";

    // Disable forward navigation at the current month.
    const atNow = year === today.getFullYear() && month === today.getMonth();
    (<HTMLButtonElement>$("cal-next")).disabled = atNow;
  }

  // -------------------------------------------------------------- history
  function renderHistory() {
    const done = workouts.filter((w) => w.ended_at);
    if (!done.length) {
      $("history-list").innerHTML = '<p class="muted">No finished workouts yet.</p>';
      return;
    }
    $("history-list").innerHTML = done.map((w) => {
      const rows = allSets.filter((s) => s.workout_id === w.id);
      const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
      const mins = Math.round((+new Date(w.ended_at!) - +new Date(w.started_at)) / 60000);
      return `<button type="button" class="hist-row" data-w="${w.id}">
        <span class="hist-day">${esc(w.day)}</span>
        <span class="hist-meta">${fmtDate(w.started_at)} · ${plural(rows.length, "set")} · ${vol} vol · ${mins} min</span>
      </button>`;
    }).join("");

    $("history-list").querySelectorAll<HTMLButtonElement>(".hist-row").forEach((b) =>
      b.addEventListener("click", () => openWorkout(b.dataset.w!)));
  }

  function openWorkout(id: string) {
    const w = workouts.find((x) => x.id === id);
    if (!w) return;
    const rows = allSets.filter((s) => s.workout_id === id);
    const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
    const mins = w.ended_at
      ? Math.round((+new Date(w.ended_at) - +new Date(w.started_at)) / 60000) : 0;

    $("workout-title").textContent = w.day;
    $("workout-meta").textContent =
      `${fmtDate(w.started_at)} · ${plural(rows.length, "set")} · ${vol} vol · ${mins} min`;

    const byEx = new Map<string, SetRow[]>();
    for (const s of rows) {
      if (!byEx.has(s.exercise_id)) byEx.set(s.exercise_id, []);
      byEx.get(s.exercise_id)!.push(s);
    }
    $("workout-detail").innerHTML = byEx.size
      ? [...byEx].map(([exId, list]) => `<section class="ex-card">
          <h2>${esc(nameOf(exId))}</h2>
          <ul class="set-list">${list.sort((a, b) => a.set_number - b.set_number)
            .map((s) => `<li class="set-row"><span class="set-main">
              <span class="set-n">${s.set_number}</span>
              <span class="set-val">${s.weight}${s.unit} × ${s.reps}${isPR(s) ? CAT : ""}</span></span></li>`).join("")}</ul>
        </section>`).join("")
      : '<p class="muted">No sets were logged.</p>';

    goto("workout");
  }

  // -------------------------------------------------------------- progress
  // Everything combined, so you can see whether the whole programme is
  // moving rather than one lift at a time.
  function renderOverall() {
    const metric = (<HTMLSelectElement>$("overall-metric")).value;
    const canvas = <HTMLCanvasElement>$("overall-chart");

    if (!allSets.length) {
      overallChart?.destroy(); overallChart = null;
      canvas.style.display = "none";
      $("overall-msg").textContent = "Nothing logged yet.";
      return;
    }
    canvas.style.display = "";

    // Volume cannot mix units on one axis, so chart the dominant one.
    const kg = allSets.filter((r) => r.unit === "kg").length;
    const unit = kg > allSets.length - kg ? "kg" : "lbs";
    const usable = metric === "volume"
      ? allSets.filter((r) => r.unit === unit)
      : allSets;
    const dropped = metric === "volume" ? allSets.length - usable.length : 0;

    let labels: string[] = [];
    let values: number[] = [];
    let label = "";

    if (metric === "weekly") {
      // Bucket by the Monday that starts each week.
      const byWeek = new Map<string, Set<string>>();
      for (const r of usable) {
        const d = new Date(r.performed_at);
        d.setHours(0, 0, 0, 0);
        d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
        const k = keyOf(d);
        if (!byWeek.has(k)) byWeek.set(k, new Set());
        byWeek.get(k)!.add(dayKey(r.performed_at));
      }
      labels = [...byWeek.keys()].sort();
      values = labels.map((k) => byWeek.get(k)!.size);
      label = "Sessions per week";
      labels = labels.map(fmtDayKey);
    } else {
      const byDay = new Map<string, SetRow[]>();
      for (const r of usable) {
        const k = dayKey(r.performed_at);
        if (!byDay.has(k)) byDay.set(k, []);
        byDay.get(k)!.push(r);
      }
      const keys = [...byDay.keys()].sort();
      values = keys.map((k) => {
        const rs = byDay.get(k)!;
        return metric === "sets"
          ? rs.length
          : Math.round(rs.reduce((t, r) => t + r.weight * r.reps, 0));
      });
      label = metric === "sets" ? "Sets" : `Volume (${unit})`;
      labels = keys.map(fmtDayKey);
    }

    overallChart?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    overallChart = new Chart(canvas, {
      type: metric === "weekly" ? "bar" : "line",
      data: { labels, datasets: [{
        label, data: values, borderColor: accent(),
        backgroundColor: accentFill(0.25), tension: 0.25, pointRadius: 3,
        fill: metric !== "weekly",
      }]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: ink, boxWidth: 12 } } },
        scales: {
          x: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
          y: { beginAtZero: true, ticks: { color: ink, precision: 0 },
               grid: { color: "rgba(128,128,128,.2)" } },
        },
      },
    });

    const days = new Set(allSets.map((r) => dayKey(r.performed_at))).size;
    const totalVol = Math.round(
      allSets.filter((r) => r.unit === unit).reduce((t, r) => t + r.weight * r.reps, 0)
    );
    $("overall-msg").textContent =
      `${plural(days, "session")} · ${plural(allSets.length, "set")} · ${totalVol} total volume (${unit})` +
      (dropped ? ` · ${dropped} set(s) in the other unit not charted` : "");
  }

  function renderProgressPicker() {
    const sel = <HTMLSelectElement>$("progress-exercise");
    const keep = sel.value;
    const withData = exercises.filter((e) => allSets.some((s) => s.exercise_id === e.id));
    sel.innerHTML = '<option value="">Choose an exercise…</option>' +
      DAYS.map((d) => {
        const inDay = withData.filter((e) => e.day === d);
        if (!inDay.length) return "";
        return `<optgroup label="${d}">${inDay
          .map((e) => `<option value="${e.id}">${esc(e.name)}</option>`).join("")}</optgroup>`;
      }).join("");
    if (keep) sel.value = keep;
  }

  function renderProgress() {
    const exId = (<HTMLSelectElement>$("progress-exercise")).value;
    const metric = (<HTMLSelectElement>$("progress-metric")).value;
    const canvas = <HTMLCanvasElement>$("progress-chart");

    if (!exId) {
      progressChart?.destroy(); progressChart = null;
      canvas.style.display = "none";
      $("progress-msg").textContent = "Pick an exercise.";
      $("progress-table").innerHTML = "";
      return;
    }

    const rows = allSets.filter((s) => s.exercise_id === exId);
    if (!rows.length) {
      progressChart?.destroy(); progressChart = null;
      canvas.style.display = "none";
      $("progress-msg").textContent = "Nothing logged for this exercise yet.";
      $("progress-table").innerHTML = "";
      return;
    }
    canvas.style.display = "";

    const kg = rows.filter((r) => r.unit === "kg").length;
    const unit = kg > rows.length - kg ? "kg" : "lbs";
    const inUnit = rows.filter((r) => r.unit === unit);
    const dropped = rows.length - inUnit.length;

    const byDay = new Map<string, SetRow[]>();
    for (const r of inUnit) {
      const k = dayKey(r.performed_at);
      if (!byDay.has(k)) byDay.set(k, []);
      byDay.get(k)!.push(r);
    }
    const labels = [...byDay.keys()].sort();
    const values = labels.map((d) => {
      const rs = byDay.get(d)!;
      if (metric === "volume") return Math.round(rs.reduce((t, r) => t + r.weight * r.reps, 0));
      if (metric === "top") return Math.max(...rs.map((r) => r.weight));
      return Math.round(Math.max(...rs.map((r) => e1rm(r.weight, r.reps))));
    });
    const label = metric === "volume" ? `Volume (${unit})`
      : metric === "top" ? `Heaviest set (${unit})` : `Est. 1RM (${unit})`;

    progressChart?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    progressChart = new Chart(canvas, {
      type: "line",
      data: { labels, datasets: [{
        label, data: values, borderColor: accent(),
        backgroundColor: accentFill(0.15), tension: 0.25, pointRadius: 3, fill: true,
      }]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: ink, boxWidth: 12 } } },
        scales: {
          x: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
          y: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
        },
      },
    });

    $("progress-msg").textContent = dropped
      ? `${dropped} set(s) logged in the other unit are not shown.` : "";

    const recent = [...byDay.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1)).slice(0, 10);
    $("progress-table").innerHTML = recent.map(([d, rs]) =>
      `<div class="hist-row static">
        <span class="hist-day">${fmtDayKey(d)}</span>
        <span class="hist-meta">${rs.sort((a, b) => a.set_number - b.set_number)
          .map((r) => `${r.weight}×${r.reps}`).join(", ")}</span>
      </div>`).join("");
  }
</script>
