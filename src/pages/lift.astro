---
import Layout from "../layouts/Layout.astro";

const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];
---

<Layout title="Lift — Tanuj Namdeo" description="Private workout log." noindex>
  <main class="lift">
    <section id="unconfigured" hidden>
      <h1>Lift</h1>
      <pre class="terminal"><span class="prompt">$</span> lift
error: Supabase credentials not set
set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY</pre>
    </section>

    <!-- Sign in -->
    <section id="auth" hidden>
      <h1>Lift</h1>
      <h2>Sign in</h2>
      <form id="auth-form" class="stack">
        <input
          type="password"
          id="password"
          placeholder="Password"
          required
          autocomplete="current-password"
        />
        <button type="submit" class="btn btn-primary">Unlock</button>
      </form>
      <p id="auth-msg" class="description" role="status"></p>
    </section>

    <!-- Pick a day -->
    <section id="pick-day" hidden>
      <h1>Lift</h1>
      <p class="description">What are you training?</p>
      <div class="day-grid">
        {
          DAYS.map((d) => (
            <button class="btn day-btn" type="button" data-day={d}>
              {d}
            </button>
          ))
        }
      </div>

      <h2>Recent</h2>
      <div id="recent"></div>

      <p class="lift-foot">
        <button id="signout" class="btn btn-quiet" type="button">Sign out</button>
      </p>
    </section>

    <!-- Active session -->
    <section id="session" hidden>
      <div class="session-bar">
        <h1 id="session-day">Day</h1>
        <div class="session-meta">
          <time id="timer">0:00</time>
          <button id="finish" class="btn btn-quiet" type="button">Finish</button>
        </div>
      </div>

      <div id="exercise-list"></div>

      <div class="row-2 add-exercise-row">
        <select id="add-exercise"><option value="">Add an exercise…</option></select>
        <button id="new-exercise" class="btn btn-quiet" type="button">+ New</button>
      </div>
      <p id="session-msg" class="description" role="status"></p>
    </section>
  </main>
</Layout>

<script>
  import { supabase, isConfigured } from "../lib/supabase";
  import Chart from "chart.js/auto";

  const ACCOUNT_EMAIL = "tanujn45@gmail.com";
  const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];

  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on = true) => ((<any>$(id)).hidden = !on);
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
    );

  type Exercise = { id: string; name: string; day: string; archived: boolean };
  type Workout = { id: string; day: string; started_at: string; ended_at: string | null };
  type SetRow = {
    id: string;
    workout_id: string;
    exercise_id: string;
    set_number: number;
    weight: number;
    unit: "lbs" | "kg";
    reps: number;
    performed_at: string;
  };

  let userId: string | null = null;
  let exercises: Exercise[] = [];
  let allSets: SetRow[] = [];
  let workouts: Workout[] = [];
  let current: Workout | null = null;
  let sessionExercises: string[] = [];
  let timerHandle: number | null = null;
  const charts = new Map<string, Chart>();

  // If a call never settles, fail loudly rather than looking successful.
  function withTimeout<T>(p: PromiseLike<T>, ms = 10000): Promise<T> {
    return Promise.race([
      p as Promise<T>,
      new Promise<T>((_, reject) =>
        setTimeout(() => reject(new Error("timed out talking to the database")), ms)
      ),
    ]);
  }

  const say = (msg: string) => ($("session-msg").textContent = msg);
  const e1rm = (w: number, r: number) => w * (1 + r / 30);
  const dayKey = (iso: string) => new Date(iso).toISOString().slice(0, 10);

  if (!isConfigured) {
    show("unconfigured");
  } else {
    main().catch((err) => {
      show("auth");
      $("auth-msg").textContent = `Error: ${err.message}`;
    });
  }

  async function main() {
    const { data } = await supabase.auth.getSession();

    // On localhost only, sign in automatically so the gate is out of the way
    // while building. import.meta.env.DEV is false in production builds, so
    // this whole branch is stripped from the deployed bundle.
    if (!data.session && import.meta.env.DEV && import.meta.env.PUBLIC_DEV_PASSWORD) {
      const { data: dev } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL,
        password: import.meta.env.PUBLIC_DEV_PASSWORD,
      });
      if (dev.user) {
        await afterSignIn(dev.user.id);
        wireEvents();
        return;
      }
    }

    if (data.session) {
      await afterSignIn(data.session.user.id);
    } else {
      show("auth");
    }

    // Never call supabase from inside this callback: the client holds a lock
    // while it runs and every query awaits getSession(), which deadlocks.
    supabase.auth.onAuthStateChange((_event, session) => {
      if (!session || userId) return;
      setTimeout(() => afterSignIn(session.user.id), 0);
    });

    wireEvents();
  }

  function wireEvents() {
    $("auth-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const field = <HTMLInputElement>$("password");
      $("auth-msg").textContent = "Checking…";
      const { data, error } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL,
        password: field.value,
      });
      field.value = "";
      if (error) {
        $("auth-msg").textContent =
          error.message === "Invalid login credentials"
            ? "Wrong password."
            : `Error: ${error.message}`;
        field.focus();
        return;
      }
      $("auth-msg").textContent = "";
      if (data.user) await afterSignIn(data.user.id);
    });

    $("signout").addEventListener("click", async () => {
      await supabase.auth.signOut();
      window.location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>(".day-btn").forEach((b) =>
      b.addEventListener("click", () => startWorkout(b.dataset.day!))
    );

    $("finish").addEventListener("click", finishWorkout);
    $("add-exercise").addEventListener("change", onAddExercise);
    $("new-exercise").addEventListener("click", onNewExercise);
  }

  async function afterSignIn(id: string) {
    if (userId === id) return;
    userId = id;
    show("auth", false);

    const [exRes, wRes, sRes] = await Promise.all([
      supabase.from("exercises").select("id,name,day,archived").order("name"),
      supabase
        .from("workouts")
        .select("id,day,started_at,ended_at")
        .order("started_at", { ascending: false })
        .limit(200),
      supabase
        .from("sets")
        .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at")
        .order("performed_at", { ascending: false })
        .limit(5000),
    ]);

    const failure = exRes.error ?? wRes.error ?? sRes.error;
    if (failure) {
      show("pick-day");
      say(`Could not load: ${failure.message}`);
      return;
    }

    exercises = (exRes.data ?? []) as Exercise[];
    workouts = (wRes.data ?? []) as Workout[];
    allSets = (sRes.data ?? []) as SetRow[];

    const open = workouts.find((w) => !w.ended_at);
    if (open) {
      await enterSession(open);
    } else {
      showDayPicker();
    }
  }

  function showDayPicker() {
    current = null;
    stopTimer();
    show("session", false);
    show("pick-day");
    renderRecent();
  }

  function renderRecent() {
    const done = workouts.filter((w) => w.ended_at).slice(0, 8);
    if (!done.length) {
      $("recent").innerHTML = '<p class="description">No finished workouts yet.</p>';
      return;
    }
    $("recent").innerHTML = done
      .map((w) => {
        const rows = allSets.filter((s) => s.workout_id === w.id);
        const vol = rows.reduce((t, r) => t + r.weight * r.reps, 0);
        const mins = Math.round(
          (new Date(w.ended_at!).getTime() - new Date(w.started_at).getTime()) / 60000
        );
        return `<div class="recent-row"><strong>${esc(w.day)}</strong>
          <time>${dayKey(w.started_at)} · ${rows.length} sets · ${Math.round(vol)} vol · ${mins} min</time></div>`;
      })
      .join("");
  }

  async function startWorkout(day: string) {
    if (!DAYS.includes(day)) return;
    const { data, error } = await withTimeout(
      supabase
        .from("workouts")
        .insert({ day, user_id: userId })
        .select("id,day,started_at,ended_at")
        .single()
    );
    if (error) {
      say(`Could not start: ${error.message}`);
      return;
    }
    const w = data as Workout;
    workouts.unshift(w);

    // Seed the session with this day's exercises; remove what you are not
    // doing and add anything else.
    const forDay = exercises.filter((e) => e.day === day && !e.archived);
    if (forDay.length) {
      const rows = forDay.map((e, i) => ({
        user_id: userId,
        workout_id: w.id,
        exercise_id: e.id,
        position: i,
      }));
      await supabase.from("workout_exercises").insert(rows);
    }
    await enterSession(w);
  }

  async function enterSession(w: Workout) {
    current = w;
    show("pick-day", false);
    show("session");
    $("session-day").textContent = w.day;

    const { data, error } = await supabase
      .from("workout_exercises")
      .select("exercise_id,position")
      .eq("workout_id", w.id)
      .order("position");

    if (error) {
      say(`Could not load exercises: ${error.message}`);
      return;
    }
    sessionExercises = (data ?? []).map((r: any) => r.exercise_id);

    startTimer();
    renderAddPicker();
    renderSession();
  }

  async function finishWorkout() {
    if (!current) return;
    const { error } = await withTimeout(
      supabase
        .from("workouts")
        .update({ ended_at: new Date().toISOString() })
        .eq("id", current.id)
    );
    if (error) {
      say(`Could not finish: ${error.message}`);
      return;
    }
    const w = workouts.find((x) => x.id === current!.id);
    if (w) w.ended_at = new Date().toISOString();
    charts.forEach((c) => c.destroy());
    charts.clear();
    showDayPicker();
  }

  function startTimer() {
    stopTimer();
    const tick = () => {
      if (!current) return;
      const ms = Date.now() - new Date(current.started_at).getTime();
      const total = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const s = total % 60;
      $("timer").textContent = h
        ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
        : `${m}:${String(s).padStart(2, "0")}`;
    };
    tick();
    timerHandle = window.setInterval(tick, 1000);
  }

  function stopTimer() {
    if (timerHandle) window.clearInterval(timerHandle);
    timerHandle = null;
  }

  function renderAddPicker() {
    const sel = <HTMLSelectElement>$("add-exercise");
    const available = exercises.filter(
      (e) => !e.archived && !sessionExercises.includes(e.id)
    );
    sel.innerHTML =
      '<option value="">Add an exercise…</option>' +
      DAYS.map((d) => {
        const inDay = available.filter((e) => e.day === d);
        if (!inDay.length) return "";
        return `<optgroup label="${d}">${inDay
          .map((e) => `<option value="${e.id}">${esc(e.name)}</option>`)
          .join("")}</optgroup>`;
      }).join("");
  }

  async function onAddExercise() {
    const sel = <HTMLSelectElement>$("add-exercise");
    const id = sel.value;
    if (!id || !current) return;
    sel.value = "";
    const { error } = await withTimeout(
      supabase.from("workout_exercises").insert({
        user_id: userId,
        workout_id: current.id,
        exercise_id: id,
        position: sessionExercises.length,
      })
    );
    if (error) {
      say(`Could not add: ${error.message}`);
      return;
    }
    sessionExercises.push(id);
    renderAddPicker();
    renderSession();
  }

  async function onNewExercise() {
    if (!current) return;
    const name = prompt("Exercise name")?.trim();
    if (!name) return;
    const day = prompt(`Which day? (${DAYS.join(", ")})`, current.day)?.trim() ?? "";
    const match = DAYS.find((d) => d.toLowerCase() === day.toLowerCase());
    if (!match) {
      say(`"${day}" is not one of ${DAYS.join(", ")}.`);
      return;
    }

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase
          .from("exercises")
          .insert({ name, day: match, user_id: userId })
          .select("id,name,day,archived")
          .single()
      ));
    } catch (err) {
      say(`Error: ${(err as Error).message}`);
      return;
    }
    if (error) {
      say(
        error.message.includes("duplicate")
          ? `"${name}" already exists.`
          : `Error: ${error.message}`
      );
      return;
    }

    exercises.push(data as Exercise);
    exercises.sort((a, b) => a.name.localeCompare(b.name));
    await supabase.from("workout_exercises").insert({
      user_id: userId,
      workout_id: current.id,
      exercise_id: data.id,
      position: sessionExercises.length,
    });
    sessionExercises.push(data.id);
    renderAddPicker();
    renderSession();
  }

  async function removeExercise(exId: string) {
    if (!current) return;
    const logged = allSets.filter(
      (s) => s.workout_id === current!.id && s.exercise_id === exId
    );
    if (logged.length) {
      const name = exercises.find((e) => e.id === exId)?.name ?? "this";
      if (
        !confirm(
          `${name} has ${logged.length} set(s) logged today. Remove it and delete those sets?`
        )
      )
        return;
      const { error } = await supabase
        .from("sets")
        .delete()
        .eq("workout_id", current.id)
        .eq("exercise_id", exId);
      if (error) {
        say(`Could not remove: ${error.message}`);
        return;
      }
      allSets = allSets.filter(
        (s) => !(s.workout_id === current!.id && s.exercise_id === exId)
      );
    }
    const { error } = await supabase
      .from("workout_exercises")
      .delete()
      .eq("workout_id", current.id)
      .eq("exercise_id", exId);
    if (error) {
      say(`Could not remove: ${error.message}`);
      return;
    }
    sessionExercises = sessionExercises.filter((id) => id !== exId);
    charts.get(exId)?.destroy();
    charts.delete(exId);
    renderAddPicker();
    renderSession();
  }

  // Same set number, from the most recent previous session containing it.
  function lastTime(exId: string, setNumber: number): SetRow | null {
    const previous = allSets
      .filter(
        (s) =>
          s.exercise_id === exId &&
          s.workout_id !== current?.id &&
          s.set_number === setNumber
      )
      .sort(
        (a, b) =>
          new Date(b.performed_at).getTime() - new Date(a.performed_at).getTime()
      );
    return previous[0] ?? null;
  }

  function renderSession() {
    if (!current) return;
    const host = $("exercise-list");

    if (!sessionExercises.length) {
      host.innerHTML = '<p class="description">No exercises yet — add one below.</p>';
      return;
    }

    host.innerHTML = sessionExercises
      .map((exId) => {
        const ex = exercises.find((e) => e.id === exId);
        if (!ex) return "";
        const done = allSets
          .filter((s) => s.workout_id === current!.id && s.exercise_id === exId)
          .sort((a, b) => a.set_number - b.set_number);
        const nextNum = done.length + 1;
        const prev = lastTime(exId, nextNum);
        const lastUnit =
          done[done.length - 1]?.unit ?? localStorage.getItem("lift:unit") ?? "lbs";

        const rows = done
          .map((s) => {
            const was = lastTime(exId, s.set_number);
            const delta = was ? s.weight - was.weight : null;
            const arrow = delta === null || delta === 0 ? "" : delta > 0 ? " ▲" : " ▼";
            return `<li>
              <span class="set-line">${s.set_number}. ${s.weight}${s.unit} × ${s.reps}${arrow}</span>
              ${was ? `<span class="was">was ${was.weight}${was.unit} × ${was.reps}</span>` : ""}
              <button class="btn btn-quiet del-set" data-set="${s.id}">×</button>
            </li>`;
          })
          .join("");

        return `<div class="exercise-card" data-ex="${exId}">
          <div class="exercise-head">
            <h2>${esc(ex.name)}</h2>
            <button class="btn btn-quiet remove-ex" data-ex="${exId}">remove</button>
          </div>
          <ul class="set-list">${rows}</ul>

          <form class="set-form row-3" data-ex="${exId}">
            <label class="field">
              <span>Set ${nextNum} weight</span>
              <input type="number" class="in-weight" inputmode="decimal" step="0.5" min="0" required />
            </label>
            <label class="field">
              <span>Unit</span>
              <select class="in-unit">
                <option value="lbs"${lastUnit === "lbs" ? " selected" : ""}>lbs</option>
                <option value="kg"${lastUnit === "kg" ? " selected" : ""}>kg</option>
              </select>
            </label>
            <label class="field">
              <span>Reps</span>
              <input type="number" class="in-reps" inputmode="numeric" step="1" min="1" required />
            </label>
            <button type="submit" class="btn btn-primary">Log</button>
          </form>
          <p class="description last-hint">${
            prev
              ? `Last time, set ${nextNum}: <strong>${prev.weight}${prev.unit} × ${prev.reps}</strong>`
              : `No set ${nextNum} on record for this exercise yet.`
          }</p>

          <canvas class="ex-chart" height="150"></canvas>
        </div>`;
      })
      .join("");

    host.querySelectorAll<HTMLFormElement>(".set-form").forEach((f) =>
      f.addEventListener("submit", onLogSet)
    );
    host.querySelectorAll<HTMLButtonElement>(".remove-ex").forEach((b) =>
      b.addEventListener("click", () => removeExercise(b.dataset.ex!))
    );
    host.querySelectorAll<HTMLButtonElement>(".del-set").forEach((b) =>
      b.addEventListener("click", () => deleteSet(b.dataset.set!))
    );

    sessionExercises.forEach(renderChart);
  }

  async function onLogSet(e: Event) {
    e.preventDefault();
    const form = <HTMLFormElement>e.currentTarget;
    const exId = form.dataset.ex!;
    if (!current) return;

    const weight = parseFloat((<HTMLInputElement>form.querySelector(".in-weight")).value);
    const reps = parseInt((<HTMLInputElement>form.querySelector(".in-reps")).value, 10);
    const unit = <"lbs" | "kg">(<HTMLSelectElement>form.querySelector(".in-unit")).value;

    const done = allSets.filter(
      (s) => s.workout_id === current!.id && s.exercise_id === exId
    );
    const set_number = done.length + 1;

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase
          .from("sets")
          .insert({
            user_id: userId,
            workout_id: current.id,
            exercise_id: exId,
            set_number,
            weight,
            reps,
            unit,
          })
          .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at")
          .single()
      ));
    } catch (err) {
      say(`Error: ${(err as Error).message}`);
      return;
    }
    if (error) {
      say(`Error: ${error.message}`);
      return;
    }

    allSets.unshift(data as SetRow);
    localStorage.setItem("lift:unit", unit);
    say("");
    renderSession();
  }

  async function deleteSet(id: string) {
    const { error } = await withTimeout(supabase.from("sets").delete().eq("id", id));
    if (error) {
      say(`Could not delete: ${error.message}`);
      return;
    }
    allSets = allSets.filter((s) => s.id !== id);
    renderSession();
  }

  function renderChart(exId: string) {
    const card = document.querySelector(`.exercise-card[data-ex="${exId}"]`);
    const canvas = card?.querySelector<HTMLCanvasElement>(".ex-chart");
    if (!canvas) return;

    const rows = allSets.filter((s) => s.exercise_id === exId);
    if (rows.length < 2) {
      canvas.style.display = "none";
      return;
    }
    canvas.style.display = "";

    // Mixed units on one axis would be meaningless, so chart the dominant one.
    const kg = rows.filter((r) => r.unit === "kg").length;
    const unit = kg > rows.length - kg ? "kg" : "lbs";
    const inUnit = rows.filter((r) => r.unit === unit);

    const byDay = new Map<string, SetRow[]>();
    for (const r of inUnit) {
      const k = dayKey(r.performed_at);
      if (!byDay.has(k)) byDay.set(k, []);
      byDay.get(k)!.push(r);
    }

    const labels = [...byDay.keys()].sort();
    const values = labels.map((d) =>
      Math.round(Math.max(...byDay.get(d)!.map((r) => e1rm(r.weight, r.reps))))
    );

    charts.get(exId)?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    charts.set(
      exId,
      new Chart(canvas, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              label: `Est. 1RM (${unit})`,
              data: values,
              borderColor: "#50fa7b",
              backgroundColor: "rgba(80,250,123,0.15)",
              tension: 0.25,
              pointRadius: 3,
              fill: true,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { labels: { color: ink, boxWidth: 12 } } },
          scales: {
            x: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
            y: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
          },
        },
      })
    );
  }
</script>
