---
import Layout from "../layouts/Layout.astro";

const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];
---

<Layout title="Lift" description="Private workout log." noindex bare>
  <main class="lift">
    <section id="unconfigured" hidden>
      <h1>Lift</h1>
      <pre class="terminal"><span class="prompt">$</span> lift
error: Supabase credentials not set</pre>
    </section>

    <section id="auth" hidden>
      <h1>Lift</h1>
      <form id="auth-form" class="stack">
        <input type="password" id="password" placeholder="Password" required
          autocomplete="current-password" />
        <button type="submit" class="btn btn-primary">Unlock</button>
      </form>
      <p id="auth-msg" class="description" role="status"></p>
    </section>

    <!-- ============ HOME: pick a day ============ -->
    <section id="view-home" class="view" hidden>
      <div class="screen-head">
        <h1 id="home-date">—</h1>
        <button id="open-manage" class="icon-btn gear" type="button"
          aria-label="Manage exercises and categories" title="Manage">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.14.35.4.64.73.83H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </button>
      </div>
      <div class="day-grid">
        {DAYS.map((d) => (
          <button class="btn day-btn" type="button" data-day={d}>{d}</button>
        ))}
      </div>
      <section class="consistency">
        <div class="cal-head">
          <button id="cal-prev" class="cal-nav" type="button" aria-label="Previous month">←</button>
          <strong id="cal-title">—</strong>
          <button id="cal-next" class="cal-nav" type="button" aria-label="Next month">→</button>
        </div>
        <div class="cal-dow">
          <span>M</span><span>T</span><span>W</span><span>T</span>
          <span>F</span><span>S</span><span>S</span>
        </div>
        <div id="cal" class="cal-grid"></div>
        <p id="cal-note" class="muted"></p>
        <div id="cal-day"></div>
      </section>

      <p class="muted">
        <button id="signout" class="linkish" type="button">Sign out</button>
      </p>
    </section>

    <!-- ============ SESSION ============ -->
    <section id="view-session" class="view" hidden>
      <div class="session-head">
        <div>
          <h1 id="session-day">Day</h1>
          <time id="timer">0:00</time>
        </div>
        <button id="finish" class="btn" type="button">Finish</button>
      </div>

      <div id="finish-panel" class="finish-panel" hidden>
        <p id="finish-summary" class="muted"></p>
        <div class="finish-actions">
          <button id="finish-save" class="btn btn-primary" type="button">Save workout</button>
          <button id="finish-discard" class="btn btn-danger" type="button">Discard</button>
          <button id="finish-cancel" class="linkish" type="button">Keep going</button>
        </div>
      </div>

      <div id="exercise-list"></div>

      <button id="open-picker" class="btn btn-wide" type="button">
        + Add exercise
      </button>
      <p id="session-msg" class="description" role="status"></p>
    </section>

    <div id="undo-bar" class="undo-bar" hidden>
      <span id="undo-text"></span>
      <button id="undo-btn" class="btn btn-sm" type="button">Undo</button>
    </div>

    <!-- ============ POST-WORKOUT SUMMARY ============ -->
    <section id="view-summary" class="view" hidden>
      <h1 id="sum-title">Done</h1>
      <p id="sum-meta" class="muted"></p>
      <div id="sum-tiles" class="sum-tiles"></div>
      <p id="sum-verdict" class="sum-verdict"></p>
      <canvas id="sum-chart" height="150"></canvas>
      <h2>By exercise</h2>
      <div id="sum-exercises"></div>
      <button id="sum-done" class="btn btn-primary btn-wide" type="button">Done</button>
    </section>

    <!-- ============ MANAGE ============ -->
    <section id="view-manage" class="view" hidden>
      <div class="screen-head">
        <h1>Manage</h1>
        <button id="manage-back" class="linkish" type="button">Done</button>
      </div>
      <p class="muted">Tap a category to see what is in it.</p>

      <div id="manage-list"></div>

      <form id="new-day-form" class="manage-add manage-new-day">
        <input type="text" id="new-day-name" placeholder="New category…" />
        <button type="submit" class="btn btn-sm">Add</button>
      </form>

      <div id="manage-hidden"></div>
      <p id="manage-msg" class="picker-msg" role="status"></p>
    </section>

    <!-- ============ HISTORY ============ -->
    <section id="view-history" class="view" hidden>
      <h1>History</h1>
      <div id="history-list"></div>
    </section>

    <!-- ============ PROGRESS ============ -->
    <section id="view-progress" class="view" hidden>
      <h1>Progress</h1>

      <h2>Overall</h2>
      <select id="overall-metric" class="wide">
        <option value="volume">Volume per session</option>
        <option value="sets">Sets per session</option>
        <option value="weekly">Sessions per week</option>
      </select>
      <canvas id="overall-chart" height="200"></canvas>
      <p id="overall-msg" class="muted"></p>

      <h2>By exercise</h2>
      <select id="progress-exercise" class="wide">
        <option value="">Choose an exercise…</option>
      </select>
      <select id="progress-metric" class="wide">
        <option value="e1rm">Estimated 1RM</option>
        <option value="top">Heaviest set</option>
        <option value="volume">Total volume</option>
      </select>
      <canvas id="progress-chart" height="220"></canvas>
      <p id="progress-msg" class="muted"></p>
      <div id="progress-table"></div>
    </section>

    <!-- ============ EXERCISE PICKER (sheet) ============ -->
    <div id="picker" class="sheet" hidden>
      <div class="sheet-inner">
        <div class="sheet-head">
          <strong>Add exercise</strong>
          <button id="picker-close" class="linkish" type="button">Close</button>
        </div>
        <p id="picker-msg" class="picker-msg" role="status"></p>
        <div id="picker-list" class="picker-list"></div>
        <form id="new-exercise-form" class="stack sheet-new">
          <input type="text" id="new-ex-name" placeholder="New exercise name" />
          <select id="new-ex-day">
            {DAYS.map((d) => <option value={d}>{d}</option>)}
          </select>
          <button type="submit" class="btn btn-primary">Create &amp; add</button>
        </form>
      </div>
    </div>

    <!-- ============ REST TIMER ============ -->
    <div id="rest" class="rest" hidden>
      <div id="rest-menu" class="rest-menu" hidden>
        <button class="rest-preset" type="button" data-s="60">1:00</button>
        <button class="rest-preset" type="button" data-s="90">1:30</button>
        <button class="rest-preset" type="button" data-s="120">2:00</button>
        <button class="rest-preset" type="button" data-s="180">3:00</button>
        <button class="rest-preset" type="button" data-s="300">5:00</button>
        <button id="rest-test" class="rest-preset rest-test" type="button">Test sound</button>
        <button id="rest-stop" class="rest-preset rest-stop" type="button">Stop</button>
      </div>
      <button id="rest-pill" class="rest-pill" type="button" aria-label="Rest timer">
        <span id="rest-label">Rest</span>
      </button>
    </div>

    <!-- ============ TABS ============ -->
    <nav id="tabs" class="tabbar" hidden>
      <button class="tab" data-view="home" type="button">Workout</button>
      <button class="tab" data-view="history" type="button">History</button>
      <button class="tab" data-view="progress" type="button">Progress</button>
    </nav>
  </main>
</Layout>

<script>
  import { supabase, isConfigured } from "../lib/supabase";
  import Chart from "chart.js/auto";

  const ACCOUNT_EMAIL = "tanujn45@gmail.com";
  const DAYS = ["Legs", "Shoulders", "Chest", "Back", "Arms"];

  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on = true) => ((<any>$(id)).hidden = !on);
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
    );

  type Exercise = { id: string; name: string; day: string; archived: boolean };
  type Workout = { id: string; day: string; started_at: string; ended_at: string | null };
  type SetRow = {
    id: string; workout_id: string; exercise_id: string; set_number: number;
    weight: number; unit: "lbs" | "kg"; reps: number; performed_at: string;
  };

  let userId: string | null = null;
  let exercises: Exercise[] = [];
  let allSets: SetRow[] = [];
  let workouts: Workout[] = [];
  let current: Workout | null = null;
  let sessionExercises: string[] = [];
  let timerHandle: number | null = null;
  let editing: string | null = null;      // set id being edited
  let discardArmed = false;
  let calMonth: Date | null = null;   // first day of the month on screen
  let removeArmed: string | null = null;
  let pickerArmed: string | null = null;
  let days: { id: string; name: string; position: number }[] = [];
  let mgOpen = new Set<string>();
  let mgEditEx: string | null = null;
  let mgEditDay: string | null = null;
  // Keeps the last removal around so it can be put back verbatim.
  let lastRemoved: { exId: string; position: number; sets: SetRow[]; workoutId: string } | null = null;
  let undoTimer: number | null = null;
  let restEnd: number | null = null;      // epoch ms the rest ends
  let restHandle: number | null = null;
  let audio: AudioContext | null = null;
  let scheduled: OscillatorNode[] = [];
  let wakeLock: any = null;
  let beepEl: HTMLAudioElement | null = null;
  let progressChart: Chart | null = null;
  let overallChart: Chart | null = null;
  let sumChart: Chart | null = null;
  let summaryOrigin: "home" | "history" = "home";

  function withTimeout<T>(p: PromiseLike<T>, ms = 10000): Promise<T> {
    return Promise.race([
      p as Promise<T>,
      new Promise<T>((_, reject) =>
        setTimeout(() => reject(new Error("timed out talking to the database")), ms)
      ),
    ]);
  }

  const say = (m: string) => ($("session-msg").textContent = m);
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;

  // Charts should use the site's own accent rather than a colour of their own.
  const accent = () =>
    getComputedStyle(document.documentElement).getPropertyValue("--maincolor").trim() || "red";
  const accentFill = (a: number) => {
    const c = accent();
    // Named colours cannot take an alpha suffix, so paint through a canvas.
    const cv = document.createElement("canvas").getContext("2d")!;
    cv.fillStyle = c;
    const hex = cv.fillStyle as string;
    if (!hex.startsWith("#")) return c;
    const n = parseInt(hex.slice(1), 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
  };
  const e1rm = (w: number, r: number) => w * (1 + r / 30);
  // Local date, not UTC: toISOString() would push an evening Pacific workout
  // onto the next calendar day and group it wrongly on the chart.
  const dayKey = (iso: string) => {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  };

  // Format a YYYY-MM-DD key without letting Date parse it as UTC midnight.
  const fmtDayKey = (key: string) => {
    const [y, m, d] = key.split("-").map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, {
      weekday: "short", month: "short", day: "numeric",
    });
  };
  const nameOf = (id: string) => exercises.find((e) => e.id === id)?.name ?? "—";
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString(undefined, {
      weekday: "short", month: "short", day: "numeric", year: "numeric",
    });

  if (!isConfigured) show("unconfigured");
  else main().catch((err) => { show("auth"); $("auth-msg").textContent = `Error: ${err.message}`; });

  async function main() {
    const { data } = await supabase.auth.getSession();

    if (!data.session && import.meta.env.DEV && import.meta.env.PUBLIC_DEV_PASSWORD) {
      const { data: dev } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL,
        password: import.meta.env.PUBLIC_DEV_PASSWORD,
      });
      if (dev.user) { await afterSignIn(dev.user.id); wire(); return; }
    }

    if (data.session) await afterSignIn(data.session.user.id);
    else show("auth");

    // Never call supabase from inside this callback: it holds a lock and
    // every query awaits getSession(), which deadlocks.
    supabase.auth.onAuthStateChange((_e, session) => {
      if (!session || userId) return;
      setTimeout(() => afterSignIn(session.user.id), 0);
    });

    wire();
  }

  function wire() {
    $("auth-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = <HTMLInputElement>$("password");
      $("auth-msg").textContent = "Checking…";
      const { data, error } = await supabase.auth.signInWithPassword({
        email: ACCOUNT_EMAIL, password: f.value,
      });
      f.value = "";
      if (error) {
        $("auth-msg").textContent =
          error.message === "Invalid login credentials" ? "Wrong password." : `Error: ${error.message}`;
        f.focus();
        return;
      }
      $("auth-msg").textContent = "";
      if (data.user) await afterSignIn(data.user.id);
    });

    $("signout").addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>(".day-btn").forEach((b) =>
      b.addEventListener("click", () => startWorkout(b.dataset.day!))
    );
    document.querySelectorAll<HTMLButtonElement>(".tab").forEach((b) =>
      b.addEventListener("click", () => goto(b.dataset.view!))
    );

    $("finish").addEventListener("click", openFinishPanel);
    $("finish-cancel").addEventListener("click", closeFinishPanel);
    $("finish-save").addEventListener("click", () => { closeFinishPanel(); finishWorkout(); });
    $("finish-discard").addEventListener("click", onDiscard);

    $("open-picker").addEventListener("click", openPicker);
    $("open-manage").addEventListener("click", () => goto("manage"));
    $("manage-back").addEventListener("click", () => goto("home"));
    $("new-day-form").addEventListener("submit", onNewDay);
    $("picker-close").addEventListener("click", () => show("picker", false));
    $("new-exercise-form").addEventListener("submit", onNewExercise);
    $("sum-done").addEventListener("click", () => goto(summaryOrigin));
    $("undo-btn").addEventListener("click", undoRemove);
    // The pill always opens the menu. It used to cancel outright while
    // running, which made Stop unreachable and let a mis-tap kill a rest.
    $("rest-pill").addEventListener("click", () => {
      const m = $("rest-menu");
      const opening = (<any>m).hidden;
      show("rest-menu", opening);
      if (opening) $("rest-stop").textContent = restEnd ? "Stop" : "Close";
    });
    $("rest-test").addEventListener("click", () => { unlockAudio(); setTimeout(ring, 60); });
    $("rest-stop").addEventListener("click", () => {
      // Nothing running: the button is just a way out of the menu.
      if (!restEnd) { show("rest-menu", false); return; }
      stopRest();
    });
    document.querySelectorAll<HTMLButtonElement>(".rest-preset[data-s]").forEach((b) =>
      b.addEventListener("click", () => startRest(parseInt(b.dataset.s!, 10))));
    $("overall-metric").addEventListener("change", renderOverall);
    $("cal-prev").addEventListener("click", () => stepMonth(-1));
    $("cal-next").addEventListener("click", () => stepMonth(1));
    $("progress-exercise").addEventListener("change", renderProgress);
    $("progress-metric").addEventListener("change", renderProgress);
  }

  // ---------------------------------------------------------------- loading
  async function afterSignIn(id: string) {
    if (userId === id) return;
    userId = id;
    show("auth", false);

    const [ex, dy, wo, st] = await Promise.all([
      supabase.from("exercises").select("id,name,day,archived").order("name"),
      supabase.from("days").select("id,name,position").order("position"),
      supabase.from("workouts").select("id,day,started_at,ended_at")
        .order("started_at", { ascending: false }).limit(300),
      supabase.from("sets")
        .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at")
        .order("performed_at", { ascending: false }).limit(5000),
    ]);

    const bad = ex.error ?? wo.error ?? st.error;
    if (bad) { goto("home"); say(`Could not load: ${bad.message}`); return; }

    exercises = (ex.data ?? []) as Exercise[];
    // Categories live in the database now; fall back to the built-in five so
    // the day picker can never come up blank.
    days = ((dy.data ?? []) as typeof days);
    if (!days.length) days = DAYS.map((n, i) => ({ id: n, name: n, position: i }));
    renderDayButtons();
    workouts = (wo.data ?? []) as Workout[];
    allSets = (st.data ?? []) as SetRow[];

    show("tabs");
    show("rest");
    restoreRest();
    const open = workouts.find((w) => !w.ended_at);
    if (open) await enterSession(open);
    else goto("home");
  }

  // ------------------------------------------------------------------ views
  function goto(view: string) {
    for (const v of ["home", "session", "history", "progress", "summary", "manage"])
      show(`view-${v}`, false);
    show("picker", false);

    document.querySelectorAll<HTMLButtonElement>(".tab").forEach((b) =>
      b.classList.toggle("tab-on", b.dataset.view === view ||
        (view === "session" && b.dataset.view === "home") ||
        (view === "summary" && summaryOrigin === "history" && b.dataset.view === "history"))
    );

    if (view === "home") {
      // An open session owns the Workout tab.
      if (current) { show("view-session"); return; }
      show("view-home");
      $("home-date").textContent = new Date().toLocaleDateString(undefined, {
        weekday: "long", month: "short", day: "numeric",
      });
      renderCalendar();
    } else if (view === "session") {
      show("view-session");
    } else if (view === "history") {
      show("view-history");
      renderHistory();
    } else if (view === "progress") {
      show("view-progress");
      renderOverall();
      renderProgressPicker();
      renderProgress();
    } else if (view === "manage") {
      mgEditEx = null;
      mgEditDay = null;
      mSay("");
      show("view-manage");
      renderManage();
    } else if (view === "summary") {
      show("view-summary");
    }
  }

  // --------------------------------------------------------------- lifecycle
  async function startWorkout(day: string) {
    if (!dayNames().includes(day)) return;
    const { data, error } = await withTimeout(
      supabase.from("workouts").insert({ day, user_id: userId })
        .select("id,day,started_at,ended_at").single()
    );
    if (error) {
      // One open session per user is a database constraint; surface it as
      // English, and resume the session that already exists.
      if (error.message.includes("workouts_one_open_per_user")) {
        const { data: open } = await supabase
          .from("workouts").select("id,day,started_at,ended_at")
          .is("ended_at", null).limit(1).single();
        if (open) {
          workouts.unshift(open as Workout);
          await enterSession(open as Workout);
          say("You already had a workout open — resumed it.");
          return;
        }
      }
      say(`Could not start: ${error.message}`);
      return;
    }
    const w = data as Workout;
    workouts.unshift(w);

    const forDay = exercises.filter((e) => e.day === day && !e.archived);
    if (forDay.length) {
      await supabase.from("workout_exercises").insert(
        forDay.map((e, i) => ({
          user_id: userId, workout_id: w.id, exercise_id: e.id, position: i,
        }))
      );
    }
    await enterSession(w);
  }

  async function enterSession(w: Workout) {
    current = w;
    $("session-day").textContent = w.day;
    const { data, error } = await supabase.from("workout_exercises")
      .select("exercise_id,position").eq("workout_id", w.id).order("position");
    if (error) { say(`Could not load exercises: ${error.message}`); return; }
    sessionExercises = (data ?? []).map((r: any) => r.exercise_id);
    startTimer();
    goto("session");
    renderSession();
  }

  function openFinishPanel() {
    if (!current) return;
    discardArmed = false;
    const rows = allSets.filter((x) => x.workout_id === current!.id);
    const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
    const mins = Math.round((Date.now() - +new Date(current.started_at)) / 60000);
    $("finish-summary").textContent =
      `${plural(rows.length, "set")} · ${vol} vol · ${mins} min`;
    const d = $("finish-discard");
    d.textContent = rows.length ? `Discard ${rows.length}` : "Discard";
    d.classList.remove("armed");
    show("finish-panel");
  }

  function closeFinishPanel() {
    discardArmed = false;
    show("finish-panel", false);
  }

  // Discarding deletes the sets, so ask twice when there is something to lose.
  function onDiscard() {
    if (!current) return;
    const rows = allSets.filter((x) => x.workout_id === current!.id);
    const d = $("finish-discard");
    if (rows.length && !discardArmed) {
      discardArmed = true;
      d.textContent = "Tap again to delete";
      d.classList.add("armed");
      setTimeout(() => {
        if (!discardArmed) return;
        discardArmed = false;
        d.textContent = `Discard ${rows.length}`;
        d.classList.remove("armed");
      }, 4000);
      return;
    }
    discardArmed = false;
    discardWorkout();
  }

  async function discardWorkout() {
    if (!current) return;
    const id = current.id;
    // sets and workout_exercises cascade from the workout row.
    const { error } = await withTimeout(
      supabase.from("workouts").delete().eq("id", id)
    );
    if (error) { say(`Could not discard: ${error.message}`); return; }
    workouts = workouts.filter((w) => w.id !== id);
    allSets = allSets.filter((x) => x.workout_id !== id);
    current = null;
    stopTimer();
    closeFinishPanel();
    goto("home");
  }

  async function finishWorkout() {
    if (!current) return;
    const { error } = await withTimeout(
      supabase.from("workouts").update({ ended_at: new Date().toISOString() })
        .eq("id", current.id)
    );
    if (error) { say(`Could not finish: ${error.message}`); return; }
    const finishedId = current.id;
    const w = workouts.find((x) => x.id === finishedId);
    if (w) w.ended_at = new Date().toISOString();
    current = null;
    stopTimer();
    showSummary(finishedId);
  }

  // ------------------------------------------------------------- summary
  // Shown straight after saving: what you just did, against the last time you
  // trained the same category.
  function showSummary(id: string, origin: "home" | "history" = "home") {
    const w = workouts.find((x) => x.id === id);
    if (!w) { goto("home"); return; }
    summaryOrigin = origin;
    $("sum-done").textContent = origin === "history" ? "← Back to history" : "Done";

    const rows = allSets.filter((x) => x.workout_id === id);
    const unitOf = (list: SetRow[]) => {
      const kg = list.filter((r) => r.unit === "kg").length;
      return kg > list.length - kg ? "kg" : "lbs";
    };
    const unit = unitOf(rows);
    const volOf = (list: SetRow[]) =>
      Math.round(list.filter((r) => r.unit === unit)
        .reduce((t, r) => t + r.weight * r.reps, 0));

    const mins = w.ended_at
      ? Math.max(1, Math.round((+new Date(w.ended_at) - +new Date(w.started_at)) / 60000))
      : 0;
    const vol = volOf(rows);
    const prs = rows.filter(isPR).length;

    // The previous session of this same category that actually had sets.
    const prev = workouts
      .filter((x) => x.day === w.day && x.id !== id && x.ended_at &&
                     allSets.some((r) => r.workout_id === x.id))
      .sort((a, b) => +new Date(b.started_at) - +new Date(a.started_at))[0];
    const prevRows = prev ? allSets.filter((x) => x.workout_id === prev.id) : [];
    const prevVol = prev ? volOf(prevRows) : 0;

    $("sum-title").textContent = origin === "history" ? w.day : `${w.day} done`;
    $("sum-meta").textContent = `${fmtDate(w.started_at)} · ${mins} min`;

    const delta = prev && prevVol ? Math.round(((vol - prevVol) / prevVol) * 100) : null;
    const tile = (big: string, small: string) =>
      `<div class="sum-tile"><span class="sum-big">${big}</span><span class="sum-small">${small}</span></div>`;

    $("sum-tiles").innerHTML =
      tile(String(rows.length), plural(rows.length, "set").replace(/^\d+ /, "")) +
      tile(String(vol), `volume (${unit})`) +
      tile(String(new Set(rows.map((r) => r.exercise_id)).size), "exercises") +
      (prs ? tile(String(prs), plural(prs, "PR").replace(/^\d+ /, "")) : "");

    $("sum-verdict").innerHTML = !rows.length
      ? "No sets logged."
      : delta === null
        ? `First ${esc(w.day)} session on record — this is the benchmark now.`
        : delta > 0
          ? `<strong class="up">▲ ${delta}%</strong> more volume than your last ${esc(w.day)} (${prevVol}).`
          : delta < 0
            ? `<strong class="down">▼ ${Math.abs(delta)}%</strong> less volume than your last ${esc(w.day)} (${prevVol}).`
            : `Same volume as your last ${esc(w.day)}.`;

    renderSummaryChart(w.day, unit, id);
    renderSummaryExercises(rows, prevRows, unit, prev);
    goto("summary");
  }

  function renderSummaryChart(day: string, unit: string, currentId: string) {
    const canvas = <HTMLCanvasElement>$("sum-chart");
    const sessions = workouts
      .filter((x) => x.day === day && allSets.some((r) => r.workout_id === x.id))
      .sort((a, b) => +new Date(a.started_at) - +new Date(b.started_at))
      .slice(-8);

    if (sessions.length < 2) {
      sumChart?.destroy(); sumChart = null;
      canvas.style.display = "none";
      return;
    }
    canvas.style.display = "";

    const labels = sessions.map((x) => fmtDayKey(dayKey(x.started_at)));
    const values = sessions.map((x) =>
      Math.round(allSets.filter((r) => r.workout_id === x.id && r.unit === unit)
        .reduce((t, r) => t + r.weight * r.reps, 0)));
    // Highlight the session just finished.
    const colours = sessions.map((x) =>
      x.id === currentId ? accent() : "rgba(128,128,128,0.45)");

    sumChart?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    sumChart = new Chart(canvas, {
      type: "bar",
      data: { labels, datasets: [{ label: `Volume (${unit})`, data: values, backgroundColor: colours }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: ink }, grid: { display: false } },
          y: { beginAtZero: true, ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
        },
      },
    });
  }

  function renderSummaryExercises(rows: SetRow[], prevRows: SetRow[], unit: string, prev?: Workout) {
    const ids = [...new Set(rows.map((r) => r.exercise_id))];
    if (!ids.length) { $("sum-exercises").innerHTML = '<p class="muted">Nothing logged.</p>'; return; }

    $("sum-exercises").innerHTML = ids.map((exId) => {
      const mine = rows.filter((r) => r.exercise_id === exId);
      const theirs = prevRows.filter((r) => r.exercise_id === exId);
      const vol = Math.round(mine.filter((r) => r.unit === unit).reduce((t, r) => t + r.weight * r.reps, 0));
      const pVol = Math.round(theirs.filter((r) => r.unit === unit).reduce((t, r) => t + r.weight * r.reps, 0));
      const best = Math.max(...mine.map((r) => r.weight));
      const gotPR = mine.some(isPR);

      let note = "";
      if (!prev) note = '<span class="muted">first time</span>';
      else if (!theirs.length) note = '<span class="muted">new this session</span>';
      else if (pVol) {
        const d = Math.round(((vol - pVol) / pVol) * 100);
        note = d > 0 ? `<span class="up">▲ ${d}%</span>`
             : d < 0 ? `<span class="down">▼ ${Math.abs(d)}%</span>`
             : '<span class="muted">level</span>';
      }

      return `<div class="sum-row">
        <span class="sum-name">${esc(nameOf(exId))}${gotPR ? CAT : ""}</span>
        <span class="sum-nums">${plural(mine.length, "set")} · top ${best}${unit} · ${vol} vol ${note}</span>
      </div>`;
    }).join("");
  }

  function startTimer() {
    stopTimer();
    const tick = () => {
      if (!current) return;
      const t = Math.max(0, Math.floor((Date.now() - new Date(current.started_at).getTime()) / 1000));
      const h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
      $("timer").textContent = h
        ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
        : `${m}:${String(s).padStart(2, "0")}`;
    };
    tick();
    timerHandle = window.setInterval(tick, 1000);
  }
  function stopTimer() { if (timerHandle) clearInterval(timerHandle); timerHandle = null; }

  // ------------------------------------------------------------ the picker
  // Shows the WHOLE library grouped by day. Things already in the session are
  // shown greyed out rather than hidden, which is what made this confusing.
  function openPicker() {
    pickerArmed = null;
    $("picker-msg").textContent = "";
    show("picker");
    ($("new-ex-day") as HTMLSelectElement).value = current?.day ?? dayNames()[0] ?? "Chest";
    renderPickerList();
  }

  function renderPickerList() {
    const host = $("picker-list");
    const live = exercises.filter((e) => !e.archived);
    if (!live.length) {
      host.innerHTML = '<p class="muted">No exercises yet. Create one below.</p>';
      return;
    }
    host.innerHTML = dayNames().map((d) => {
      const inDay = live.filter((e) => e.day === d);
      if (!inDay.length) return "";
      return `<div class="picker-group"><h3>${d}</h3>${inDay
        .map((e) => {
          const already = sessionExercises.includes(e.id);
          // Deleting lives in Manage now; this sheet only picks.
          return `<div class="picker-row">
            <button type="button" class="picker-item${already ? " picker-item-on" : ""}"
              data-ex="${e.id}"${already ? " disabled" : ""}>
              ${esc(e.name)}${already ? '<span class="tag">in session</span>' : ""}
            </button>
          </div>`;
        })
        .join("")}</div>`;
    }).join("");

    host.querySelectorAll<HTMLButtonElement>(".picker-item:not([disabled])").forEach((b) =>
      b.addEventListener("click", () => addToSession(b.dataset.ex!)));
  }

  async function deleteExercise(exId: string) {
    pickerArmed = null;
    try { await doDeleteExercise(exId); }
    catch (err) {
      $("picker-msg").textContent = `Failed: ${(err as Error).message}`;
      renderPickerList();
    }
  }

  async function doDeleteExercise(exId: string) {
    const used = allSets.some((x) => x.exercise_id === exId);
    const name = nameOf(exId);

    if (used) {
      // Archive: it disappears from the picker but every past set survives.
      const { error } = await withTimeout(
        supabase.from("exercises").update({ archived: true }).eq("id", exId)
      );
      if (error) { $("picker-msg").textContent = `Could not hide: ${error.message}`; return; }
      const e = exercises.find((x) => x.id === exId);
      if (e) e.archived = true;
    } else {
      const { error } = await withTimeout(
        supabase.from("exercises").delete().eq("id", exId)
      );
      if (error) { $("picker-msg").textContent = `Could not delete: ${error.message}`; return; }
      exercises = exercises.filter((x) => x.id !== exId);
    }

    // It may be sitting in the open session; take it out of there too.
    if (sessionExercises.includes(exId) && current) {
      await supabase.from("workout_exercises").delete()
        .eq("workout_id", current.id).eq("exercise_id", exId);
      sessionExercises = sessionExercises.filter((i) => i !== exId);
    }

    $("picker-msg").textContent = used ? `${name} hidden.` : `${name} deleted.`;
    renderPickerList();
    renderSession();
  }

  async function addToSession(id: string) {
    if (!current) return;
    if (sessionExercises.includes(id)) return;

    let error: any;
    try {
      ({ error } = await withTimeout(
        supabase.from("workout_exercises").insert({
          user_id: userId, workout_id: current.id, exercise_id: id,
          position: sessionExercises.length,
        })
      ));
    } catch (err) {
      // A rejected promise used to leave the sheet doing nothing at all.
      $("picker-msg").textContent = `Could not add: ${(err as Error).message}`;
      return;
    }
    // A leftover row means it is already in the session, which is the desired
    // end state, so carry on rather than calling it a failure.
    if (error && !String(error.message).includes("duplicate")) {
      $("picker-msg").textContent = `Could not add: ${error.message}`;
      return;
    }
    sessionExercises.push(id);
    $("picker-msg").textContent = `Added ${nameOf(id)}.`;
    renderPickerList();
    renderSession();
  }

  async function onNewExercise(e: Event) {
    e.preventDefault();
    const field = <HTMLInputElement>$("new-ex-name");
    const name = field.value.trim();
    if (!name || !current) return;
    const day = (<HTMLSelectElement>$("new-ex-day")).value;

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase.from("exercises").insert({ name, day, user_id: userId })
          .select("id,name,day,archived").single()
      ));
    } catch (err) {
      $("picker-msg").textContent = `Error: ${(err as Error).message}`;
      return;
    }
    if (error) {
      $("picker-msg").textContent = error.message.includes("duplicate")
        ? `"${name}" already exists.` : `Error: ${error.message}`;
      return;
    }
    field.value = "";
    exercises.push(data as Exercise);
    exercises.sort((a, b) => a.name.localeCompare(b.name));
    await addToSession(data.id);
  }

  // Arming shows an explicit Yes / No rather than relying on a second tap in
  // the same place, which gave no way to say no.
  function armRemove(exId: string) {
    removeArmed = exId;
    renderSession();
  }

  async function doRemoveExercise(exId: string) {
    if (!current) return;
    const logged = allSets.filter((x) => x.workout_id === current!.id && x.exercise_id === exId);
    removeArmed = null;

    const position = Math.max(0, sessionExercises.indexOf(exId));
    const workoutId = current.id;

    if (logged.length) {
      const { error } = await supabase.from("sets").delete()
        .eq("workout_id", workoutId).eq("exercise_id", exId);
      if (error) { say(`Could not remove: ${error.message}`); return; }
      allSets = allSets.filter((x) => !(x.workout_id === workoutId && x.exercise_id === exId));
    }
    const { error } = await supabase.from("workout_exercises").delete()
      .eq("workout_id", workoutId).eq("exercise_id", exId);
    if (error) { say(`Could not remove: ${error.message}`); return; }

    sessionExercises = sessionExercises.filter((i) => i !== exId);
    lastRemoved = { exId, position, sets: logged, workoutId };
    renderSession();
    showUndo(
      `Removed ${nameOf(exId)}` +
        (logged.length ? ` and ${plural(logged.length, "set")}` : "")
    );
  }

  function showUndo(text: string) {
    $("undo-text").textContent = text;
    show("undo-bar");
    if (undoTimer) clearTimeout(undoTimer);
    undoTimer = window.setTimeout(() => {
      lastRemoved = null;
      show("undo-bar", false);
    }, 10000);
  }

  async function undoRemove() {
    if (!lastRemoved) return;
    const { exId, position, sets, workoutId } = lastRemoved;
    lastRemoved = null;
    if (undoTimer) clearTimeout(undoTimer);
    show("undo-bar", false);

    const { error } = await withTimeout(
      supabase.from("workout_exercises").insert({
        user_id: userId, workout_id: workoutId, exercise_id: exId, position,
      })
    );
    if (error) { say(`Could not undo: ${error.message}`); return; }

    if (sets.length) {
      // Re-inserted with their original ids and timestamps, so set numbers,
      // history and PR comparisons all land exactly where they were.
      const { error: setErr } = await withTimeout(
        supabase.from("sets").insert(sets.map((x) => ({ ...x, user_id: userId })))
      );
      if (setErr) { say(`Exercise restored, but sets failed: ${setErr.message}`); }
      else allSets.unshift(...sets);
    }

    if (!sessionExercises.includes(exId)) {
      sessionExercises.splice(Math.min(position, sessionExercises.length), 0, exId);
    }
    say("");
    renderAddPicker();
    renderSession();
  }

  // ------------------------------------------------------------------- PRs
  // A personal record is a set whose estimated 1RM beats every earlier set of
  // the same exercise, so more reps at the same weight counts too. Weights are
  // normalised to lbs first, otherwise switching units would fake a record.
  // With nothing earlier to compare against the set is, by definition, the
  // best for that exercise, so it counts. Suppressing it used to mean that
  // deleting an exercise's whole history stopped the next set counting.
  const toLbs = (w: number, unit: string) => (unit === "kg" ? w * 2.20462 : w);

  function isPR(set: SetRow): boolean {
    const earlier = allSets.filter(
      (s) =>
        s.exercise_id === set.exercise_id &&
        s.id !== set.id &&
        new Date(s.performed_at) < new Date(set.performed_at)
    );
    if (!earlier.length) return true;
    const best = Math.max(...earlier.map((s) => e1rm(toLbs(s.weight, s.unit), s.reps)));
    return e1rm(toLbs(set.weight, set.unit), set.reps) > best + 1e-9;
  }

  const CAT = '<img class="pr-cat" src="/img/cat.png" alt="PR" title="Personal record" />';

  // -------------------------------------------------- last time, same slot
  function lastTime(exId: string, n: number): SetRow | null {
    return allSets
      .filter((s) => s.exercise_id === exId && s.workout_id !== current?.id && s.set_number === n)
      .sort((a, b) => +new Date(b.performed_at) - +new Date(a.performed_at))[0] ?? null;
  }

  // ------------------------------------------------------------- session UI
  function renderSession() {
    if (!current) return;
    const host = $("exercise-list");
    if (!sessionExercises.length) {
      host.innerHTML = '<p class="muted">Nothing here yet — add an exercise below.</p>';
      return;
    }

    host.innerHTML = sessionExercises.map((exId) => {
      const ex = exercises.find((e) => e.id === exId);
      if (!ex) return "";
      const done = allSets
        .filter((s) => s.workout_id === current!.id && s.exercise_id === exId)
        .sort((a, b) => a.set_number - b.set_number);
      const next = done.length + 1;
      const prev = lastTime(exId, next);
      const unit = done.at(-1)?.unit ?? localStorage.getItem("lift:unit") ?? "lbs";

      const rows = done.map((s) => {
        if (editing === s.id) {
          return `<li class="set-row set-editing" data-set="${s.id}">
            <div class="ed-grid">
              <label><span>Weight</span>
                <input type="number" class="ed-weight" value="${s.weight}" step="0.5" min="0" inputmode="decimal" /></label>
              <label><span>Reps</span>
                <input type="number" class="ed-reps" value="${s.reps}" step="1" min="1" inputmode="numeric" /></label>
            </div>
            <div class="ed-actions">
              <button type="button" class="btn btn-sm save-set" data-set="${s.id}">Save set ${s.set_number}</button>
              <button type="button" class="btn btn-sm cancel-set">Cancel</button>
            </div>
          </li>`;
        }
        const was = lastTime(exId, s.set_number);
        const d = was ? s.weight - was.weight : null;
        const arrow = d === null || d === 0 ? "" : d > 0 ? " ▲" : " ▼";
        return `<li class="set-row" data-set="${s.id}">
          <button type="button" class="set-main edit-set" data-set="${s.id}">
            <span class="set-n">${s.set_number}</span>
            <span class="set-val">${s.weight}${s.unit} × ${s.reps}${arrow}${isPR(s) ? CAT : ""}</span>
            ${was ? `<span class="was">was ${was.weight}${was.unit} × ${was.reps}</span>` : ""}
          </button>
          <button type="button" class="icon-btn del-set" data-set="${s.id}" aria-label="Delete set">×</button>
        </li>`;
      }).join("");

      return `<section class="ex-card" data-ex="${exId}">
        <header class="ex-head">
          <h2>${esc(ex.name)}</h2>
          ${removeArmed === exId
            ? `<span class="confirm-row">
                 <span class="confirm-q">${done.length ? `Delete ${plural(done.length, "set")}?` : "Remove?"}</span>
                 <button type="button" class="btn btn-sm confirm-yes" data-ex="${exId}">Yes</button>
                 <button type="button" class="btn btn-sm confirm-no">No</button>
               </span>`
            : `<button type="button" class="linkish remove-ex" data-ex="${exId}">remove</button>`}
        </header>
        <ul class="set-list">${rows}</ul>
        <p class="hint">${prev
          ? `Set ${next} last time: <strong>${prev.weight}${prev.unit} × ${prev.reps}</strong>`
          : `No set ${next} on record yet.`}</p>
        <form class="log-form" data-ex="${exId}">
          <div class="log-inputs">
            <label><span>Weight</span>
              <input type="number" class="in-weight" inputmode="decimal" step="0.5" min="0" required /></label>
            <label><span>Reps</span>
              <input type="number" class="in-reps" inputmode="numeric" step="1" min="1" required /></label>
            <label><span>Unit</span>
              <select class="in-unit">
                <option value="lbs"${unit === "lbs" ? " selected" : ""}>lbs</option>
                <option value="kg"${unit === "kg" ? " selected" : ""}>kg</option>
              </select></label>
          </div>
          <button type="submit" class="btn btn-primary btn-wide">Log set ${next}</button>
        </form>
      </section>`;
    }).join("");

    host.querySelectorAll<HTMLFormElement>(".log-form").forEach((f) =>
      f.addEventListener("submit", onLogSet));
    host.querySelectorAll<HTMLButtonElement>(".remove-ex").forEach((b) =>
      b.addEventListener("click", () => armRemove(b.dataset.ex!)));
    host.querySelectorAll<HTMLButtonElement>(".confirm-yes").forEach((b) =>
      b.addEventListener("click", () => doRemoveExercise(b.dataset.ex!)));
    host.querySelectorAll<HTMLButtonElement>(".confirm-no").forEach((b) =>
      b.addEventListener("click", () => { removeArmed = null; renderSession(); }));
    host.querySelectorAll<HTMLButtonElement>(".del-set").forEach((b) =>
      b.addEventListener("click", () => deleteSet(b.dataset.set!)));
    host.querySelectorAll<HTMLButtonElement>(".edit-set").forEach((b) =>
      b.addEventListener("click", () => { editing = b.dataset.set!; renderSession(); }));
    host.querySelectorAll<HTMLButtonElement>(".save-set").forEach((b) =>
      b.addEventListener("click", () => saveSet(b.dataset.set!)));
    host.querySelectorAll<HTMLButtonElement>(".cancel-set").forEach((b) =>
      b.addEventListener("click", () => { editing = null; renderSession(); }));
  }

  async function onLogSet(e: Event) {
    e.preventDefault();
    const form = <HTMLFormElement>e.currentTarget;
    const exId = form.dataset.ex!;
    if (!current) return;
    const weight = parseFloat((<HTMLInputElement>form.querySelector(".in-weight")).value);
    const reps = parseInt((<HTMLInputElement>form.querySelector(".in-reps")).value, 10);
    const unit = <"lbs" | "kg">(<HTMLSelectElement>form.querySelector(".in-unit")).value;
    const n = allSets.filter((s) => s.workout_id === current!.id && s.exercise_id === exId).length + 1;

    let data: any, error: any;
    try {
      ({ data, error } = await withTimeout(
        supabase.from("sets").insert({
          user_id: userId, workout_id: current.id, exercise_id: exId,
          set_number: n, weight, reps, unit,
        }).select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at").single()
      ));
    } catch (err) { say(`Error: ${(err as Error).message}`); return; }
    if (error) { say(`Error: ${error.message}`); return; }

    allSets.unshift(data as SetRow);
    localStorage.setItem("lift:unit", unit);
    say("");
    renderSession();
  }

  async function saveSet(id: string) {
    const li = document.querySelector(`.set-row[data-set="${id}"]`);
    if (!li) return;
    const weight = parseFloat((<HTMLInputElement>li.querySelector(".ed-weight")).value);
    const reps = parseInt((<HTMLInputElement>li.querySelector(".ed-reps")).value, 10);
    if (!(weight >= 0) || !(reps > 0)) { say("Weight and reps must be numbers."); return; }

    const { data, error } = await withTimeout(
      supabase.from("sets").update({ weight, reps }).eq("id", id)
        .select("id,workout_id,exercise_id,set_number,weight,unit,reps,performed_at").single()
    );
    if (error) { say(`Could not save: ${error.message}`); return; }
    const i = allSets.findIndex((s) => s.id === id);
    if (i >= 0) allSets[i] = data as SetRow;
    editing = null;
    say("");
    renderSession();
  }

  async function deleteSet(id: string) {
    const { error } = await withTimeout(supabase.from("sets").delete().eq("id", id));
    if (error) { say(`Could not delete: ${error.message}`); return; }
    allSets = allSets.filter((s) => s.id !== id);
    renderSession();
  }

  // --------------------------------------------------------- rest timer
  // Counts to an absolute end time rather than decrementing, so a phone
  // throttling timers in the background cannot make it drift.
  function startRest(seconds: number) {
    unlockAudio();
    // Queue the tones now, in the audio thread. Timer throttling on a locked
    // phone cannot delay them the way it delays setInterval.
    scheduleRing(seconds);
    keepAwake();
    restEnd = Date.now() + seconds * 1000;
    try { localStorage.setItem("lift:restEnd", String(restEnd)); } catch (e) {}
    show("rest-menu", false);
    $("rest-pill").classList.add("rest-running");
    tickRest();
    if (restHandle) clearInterval(restHandle);
    restHandle = window.setInterval(tickRest, 250);
  }

  function stopRest() {
    cancelScheduled();
    releaseWake();
    restEnd = null;
    try { localStorage.removeItem("lift:restEnd"); } catch (e) {}
    if (restHandle) clearInterval(restHandle);
    restHandle = null;
    show("rest-menu", false);
    const pill = $("rest-pill");
    pill.classList.remove("rest-running", "rest-done");
    $("rest-label").textContent = "Rest";
  }

  function tickRest() {
    if (!restEnd) return;
    const left = Math.round((restEnd - Date.now()) / 1000);
    if (left > 0) {
      const m = Math.floor(left / 60);
      $("rest-label").textContent = `${m}:${String(left % 60).padStart(2, "0")}`;
      return;
    }
    // Done.
    const late = Date.now() - restEnd;
    restEnd = null;
    try { localStorage.removeItem("lift:restEnd"); } catch (e) {}
    if (restHandle) clearInterval(restHandle);
    restHandle = null;
    const pill = $("rest-pill");
    pill.classList.remove("rest-running");
    pill.classList.add("rest-done");
    $("rest-label").textContent = "Go";
    releaseWake();
    // The scheduled tones may never have sounded (a suspended context, a
    // muted switch); ringing again here costs an echo at worst.
    ring();
    // Leave "Go" up for a while; it is the thing you glance at.
    setTimeout(() => {
      if (restEnd) return;
      pill.classList.remove("rest-done");
      $("rest-label").textContent = "Rest";
    }, 15000);
  }

  // Created on a tap so the browser lets it make noise later.
  function unlockAudio() {
    try {
      // iOS 16.4+: without this, Web Audio obeys the physical ringer switch,
      // so a muted phone gives a completely silent alarm.
      const sess = (navigator as any).audioSession;
      if (sess) sess.type = "playback";
    } catch (e) {}

    try {
      if (!audio) audio = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (audio.state === "suspended") audio.resume();
    } catch (e) { audio = null; }

    // A media element is a second route to sound: it survives cases where the
    // AudioContext has been suspended out from under us.
    try {
      if (!beepEl) {
        beepEl = new Audio(beepDataUri());
        beepEl.preload = "auto";
        (beepEl as any).playsInline = true;
      }
      // Priming inside the gesture is what buys us play() later.
      beepEl.muted = true;
      beepEl.play().then(() => {
        beepEl!.pause();
        beepEl!.currentTime = 0;
        beepEl!.muted = false;
      }).catch(() => { beepEl!.muted = false; });
    } catch (e) { beepEl = null; }
  }

  // Three rising tones as a 16-bit PCM WAV, built once at runtime so there is
  // no asset to fetch when it is needed.
  function beepDataUri(): string {
    const rate = 44100, dur = 0.85;
    const n = Math.floor(rate * dur);
    const buf = new ArrayBuffer(44 + n * 2);
    const view = new DataView(buf);
    const str = (off: number, t: string) => {
      for (let i = 0; i < t.length; i++) view.setUint8(off + i, t.charCodeAt(i));
    };
    str(0, "RIFF"); view.setUint32(4, 36 + n * 2, true); str(8, "WAVEfmt ");
    view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 1, true);
    view.setUint32(24, rate, true); view.setUint32(28, rate * 2, true);
    view.setUint16(32, 2, true); view.setUint16(34, 16, true);
    str(36, "data"); view.setUint32(40, n * 2, true);

    const tones = [[0, 0.22, 660], [0.28, 0.5, 880], [0.56, 0.78, 1100]];
    for (let i = 0; i < n; i++) {
      const t = i / rate;
      let v = 0;
      for (const [a, b, f] of tones) {
        if (t >= a && t < b) {
          const env = Math.min(1, (t - a) / 0.01) * Math.min(1, (b - t) / 0.06);
          v += Math.sin(2 * Math.PI * f * t) * 0.4 * env;
        }
      }
      view.setInt16(44 + i * 2, Math.max(-1, Math.min(1, v)) * 32767, true);
    }
    let bin = "";
    const bytes = new Uint8Array(buf);
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return "data:audio/wav;base64," + btoa(bin);
  }

  function scheduleRing(inSeconds: number) {
    cancelScheduled();
    if (!audio) return;
    const base = audio.currentTime + inSeconds;
    [0, 0.28, 0.56].forEach((at, i) => {
      const osc = audio!.createOscillator();
      const gain = audio!.createGain();
      osc.type = "sine";
      osc.frequency.value = 660 + i * 220;
      const t = base + at;
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(0.35, t + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      osc.connect(gain).connect(audio!.destination);
      osc.start(t);
      osc.stop(t + 0.25);
      scheduled.push(osc);
    });
  }

  function cancelScheduled() {
    scheduled.forEach((o) => { try { o.stop(); } catch (e) {} });
    scheduled = [];
  }

  // Stops the phone sleeping mid-rest, which is what silences the alarm in
  // the first place. Needs HTTPS and a gesture; both hold here.
  async function keepAwake() {
    try {
      if (!("wakeLock" in navigator)) return;
      wakeLock = await (navigator as any).wakeLock.request("screen");
      wakeLock.addEventListener?.("release", () => { wakeLock = null; });
    } catch (e) { wakeLock = null; }
  }

  function releaseWake() {
    try { wakeLock?.release?.(); } catch (e) {}
    wakeLock = null;
  }

  function ring() {
    try { navigator.vibrate?.([250, 120, 250, 120, 450]); } catch (e) {}
    try {
      if (beepEl) { beepEl.currentTime = 0; beepEl.play().catch(() => {}); }
    } catch (e) {}
    try { if (audio?.state === "suspended") audio.resume(); } catch (e) {}
    if (!audio) return;
    // Three rising beeps: audible over music without being a klaxon.
    [0, 0.28, 0.56].forEach((at, i) => {
      const osc = audio!.createOscillator();
      const gain = audio!.createGain();
      osc.type = "sine";
      osc.frequency.value = 660 + i * 220;
      const t = audio!.currentTime + at;
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(0.35, t + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      osc.connect(gain).connect(audio!.destination);
      osc.start(t);
      osc.stop(t + 0.25);
    });
  }

  // Switching away drops the lock, so take it back if a rest is still going.
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && restEnd && !wakeLock) keepAwake();
    if (document.visibilityState === "visible") tickRest();
  });

  // A reload mid-rest should pick the countdown back up.
  function restoreRest() {
    // Sign-in can settle after a rest has already been started by hand; do
    // not adopt a stale end time or start a second interval over the top.
    if (restEnd) return;
    try {
      const saved = parseInt(localStorage.getItem("lift:restEnd") ?? "", 10);
      if (saved && saved > Date.now()) {
        restEnd = saved;
        unlockAudio();
        scheduleRing(Math.max(0, (saved - Date.now()) / 1000));
        keepAwake();
        $("rest-pill").classList.add("rest-running");
        tickRest();
        restHandle = window.setInterval(tickRest, 250);
      } else if (saved) {
        localStorage.removeItem("lift:restEnd");
      }
    } catch (e) {}
  }

  // ------------------------------------------------------------ categories
  function dayNames() {
    return days.length ? days.map((d) => d.name) : DAYS;
  }

  function renderDayButtons() {
    const host = document.querySelector(".day-grid");
    if (host) {
      host.innerHTML = days
        .map((d) => `<button class="btn day-btn" type="button" data-day="${esc(d.name)}">${esc(d.name)}</button>`)
        .join("");
      host.querySelectorAll<HTMLButtonElement>(".day-btn").forEach((b) =>
        b.addEventListener("click", () => startWorkout(b.dataset.day!)));
    }
    // Keep the new-exercise picker in step with the categories that exist.
    const sel = <HTMLSelectElement>$("new-ex-day");
    if (sel) {
      const keep = sel.value;
      sel.innerHTML = dayNames().map((n) => `<option value="${esc(n)}">${esc(n)}</option>`).join("");
      if (keep && dayNames().includes(keep)) sel.value = keep;
    }
  }

  // -------------------------------------------------------------- manage
  const mSay = (t: string) => ($("manage-msg").textContent = t);

  function renderManage() {
    const live = exercises.filter((e) => !e.archived);
    const archived = exercises.filter((e) => e.archived);

    $("manage-list").innerHTML = dayNames().map((name) => {
      const inDay = live.filter((e) => e.day === name);
      const open = mgOpen.has(name);

      // The category header, or its editor in place of it.
      const head = mgEditDay === name
        ? `<div class="mg-edit">
             <input type="text" class="md-name" value="${esc(name)}" aria-label="Category name" />
             <div class="mg-edit-actions">
               <button type="button" class="btn btn-sm md-save" data-day="${esc(name)}">Save</button>
               <button type="button" class="btn btn-sm md-del" data-day="${esc(name)}"${inDay.length ? " disabled" : ""}>Delete</button>
               <button type="button" class="btn btn-sm mg-cancel">Cancel</button>
             </div>
             ${inDay.length ? `<span class="mg-why">Move its ${plural(inDay.length, "exercise")} elsewhere before deleting.</span>` : ""}
           </div>`
        : `<div class="mg-head">
             <button type="button" class="mg-toggle" data-day="${esc(name)}">
               <span class="mg-caret">${open ? "▾" : "▸"}</span>
               <span class="mg-title">${esc(name)}</span>
               <span class="mg-count">${inDay.length}</span>
             </button>
             <button type="button" class="icon-btn mg-day-edit" data-day="${esc(name)}" aria-label="Edit ${esc(name)}">✎</button>
           </div>`;

      if (!open || mgEditDay === name) return `<div class="mg-group">${head}</div>`;

      const rows = inDay.map((e) => {
        if (mgEditEx !== e.id) {
          return `<button type="button" class="mg-row mg-ex-edit" data-id="${e.id}">
            <span class="mg-row-name">${esc(e.name)}</span>
            <span class="mg-row-hint">edit</span>
          </button>`;
        }
        const used = allSets.some((x) => x.exercise_id === e.id);
        return `<div class="mg-edit">
          <input type="text" class="me-name" value="${esc(e.name)}" aria-label="Exercise name" />
          <select class="me-day" aria-label="Category">
            ${dayNames().map((n) => `<option value="${esc(n)}"${n === e.day ? " selected" : ""}>${esc(n)}</option>`).join("")}
          </select>
          <div class="mg-edit-actions">
            <button type="button" class="btn btn-sm me-save" data-id="${e.id}">Save</button>
            <button type="button" class="btn btn-sm me-del" data-id="${e.id}">${used ? "Hide" : "Delete"}</button>
            <button type="button" class="btn btn-sm mg-cancel">Cancel</button>
          </div>
          ${used ? '<span class="mg-why">It has sets logged, so hiding keeps the history.</span>' : ""}
        </div>`;
      }).join("");

      return `<div class="mg-group mg-group-open">${head}
        <div class="mg-body">
          ${rows || '<p class="muted mg-empty">Nothing here yet.</p>'}
          <form class="manage-add" data-day="${esc(name)}">
            <input type="text" class="mg-new-name" placeholder="Add an exercise…" />
            <button type="submit" class="btn btn-sm">Add</button>
          </form>
        </div>
      </div>`;
    }).join("");

    // Hidden exercises, collapsed and out of the way at the bottom.
    $("manage-hidden").innerHTML = archived.length
      ? `<div class="mg-group"><div class="mg-head">
           <button type="button" class="mg-toggle" data-day="__hidden">
             <span class="mg-caret">${mgOpen.has("__hidden") ? "▾" : "▸"}</span>
             <span class="mg-title">Hidden</span>
             <span class="mg-count">${archived.length}</span>
           </button></div>
         ${mgOpen.has("__hidden") ? `<div class="mg-body">${archived.map((e) =>
            `<div class="mg-row">
               <span class="mg-row-name muted">${esc(e.name)}</span>
               <button type="button" class="btn btn-sm mg-restore" data-id="${e.id}">Restore</button>
             </div>`).join("")}</div>` : ""}
         </div>`
      : "";

    const host = $("view-manage");
    const on = (sel: string, fn: (b: HTMLElement) => void) =>
      host.querySelectorAll<HTMLElement>(sel).forEach((b) =>
        b.addEventListener("click", () => fn(b)));

    on(".mg-toggle", (b) => {
      const d = b.dataset.day!;
      if (mgOpen.has(d)) mgOpen.delete(d); else mgOpen.add(d);
      mgEditEx = null; mgEditDay = null;
      renderManage();
    });
    on(".mg-day-edit", (b) => { mgEditDay = b.dataset.day!; mgEditEx = null; renderManage(); });
    on(".mg-ex-edit", (b) => { mgEditEx = b.dataset.id!; mgEditDay = null; renderManage(); });
    on(".mg-cancel", () => { mgEditEx = null; mgEditDay = null; mSay(""); renderManage(); });
    on(".md-save", async (b) => {
      const input = host.querySelector<HTMLInputElement>(".md-name")!;
      await renameDay(b.dataset.day!, input.value.trim());
    });
    on(".md-del", async (b) => { await deleteDayByName(b.dataset.day!); });
    on(".me-save", async (b) => {
      const name = host.querySelector<HTMLInputElement>(".me-name")!.value.trim();
      const day = host.querySelector<HTMLSelectElement>(".me-day")!.value;
      await saveExercise(b.dataset.id!, name, day);
    });
    on(".me-del", async (b) => {
      mgEditEx = null;
      await deleteExercise(b.dataset.id!);
      mSay($("picker-msg").textContent || "");
      renderManage();
    });
    on(".mg-restore", async (b) => { await restoreExercise(b.dataset.id!); });

    host.querySelectorAll<HTMLFormElement>(".manage-add[data-day]").forEach((f) =>
      f.addEventListener("submit", (ev) => {
        ev.preventDefault();
        const input = f.querySelector<HTMLInputElement>(".mg-new-name")!;
        addExerciseToDay(input.value.trim(), f.dataset.day!, input);
      }));
  }

  async function saveExercise(exId: string, name: string, day: string) {
    if (!name) return;
    const { error } = await withTimeout(
      supabase.from("exercises").update({ name, day }).eq("id", exId)
    );
    if (error) {
      mSay(error.message.includes("duplicate") ? `"${name}" already exists.` : `Error: ${error.message}`);
      return;
    }
    const e = exercises.find((x) => x.id === exId);
    if (e) { e.name = name; e.day = day; }
    exercises.sort((a, b) => a.name.localeCompare(b.name));
    mgEditEx = null;
    mSay(`Saved ${name}.`);
    renderManage();
  }

  // The category name is stored on exercises and workouts too, so a rename
  // has to carry through all three or history would point at nothing.
  async function renameDay(oldName: string, newName: string) {
    if (!newName || newName === oldName) { mgEditDay = null; renderManage(); return; }
    const row = days.find((d) => d.name === oldName);
    if (!row) return;

    const { error } = await withTimeout(
      supabase.from("days").update({ name: newName }).eq("id", row.id)
    );
    if (error) {
      mSay(error.message.includes("duplicate") ? `"${newName}" already exists.` : `Error: ${error.message}`);
      return;
    }
    await supabase.from("exercises").update({ day: newName }).eq("day", oldName);
    await supabase.from("workouts").update({ day: newName }).eq("day", oldName);

    row.name = newName;
    exercises.forEach((e) => { if (e.day === oldName) e.day = newName; });
    workouts.forEach((w) => { if (w.day === oldName) w.day = newName; });
    if (mgOpen.delete(oldName)) mgOpen.add(newName);
    mgEditDay = null;
    mSay(`Renamed to ${newName}.`);
    renderDayButtons();
    renderManage();
  }

  async function deleteDayByName(name: string) {
    const row = days.find((d) => d.name === name);
    if (!row) return;
    mgEditDay = null;
    await deleteDay(row.id);
  }

  async function addExerciseToDay(name: string, day: string, input: HTMLInputElement) {
    if (!name) return;
    const { data, error } = await withTimeout(
      supabase.from("exercises").insert({ name, day, user_id: userId })
        .select("id,name,day,archived").single()
    );
    if (error) {
      mSay(error.message.includes("duplicate") ? `"${name}" already exists.` : `Error: ${error.message}`);
      return;
    }
    input.value = "";
    exercises.push(data as Exercise);
    exercises.sort((a, b) => a.name.localeCompare(b.name));
    mSay(`Added ${name} to ${day}.`);
    renderManage();
  }

  async function onNewDay(e: Event) {
    e.preventDefault();
    const field = <HTMLInputElement>$("new-day-name");
    const name = field.value.trim();
    if (!name) return;
    const { data, error } = await withTimeout(
      supabase.from("days")
        .insert({ user_id: userId, name, position: days.length })
        .select("id,name,position").single()
    );
    if (error) {
      mSay(error.message.includes("duplicate") ? `"${name}" already exists.` : `Error: ${error.message}`);
      return;
    }
    field.value = "";
    days.push(data as any);
    mSay(`Added ${name}.`);
    renderDayButtons();
    renderManage();
  }

  async function deleteDay(id: string) {
    const d = days.find((x) => x.id === id);
    const { error } = await withTimeout(supabase.from("days").delete().eq("id", id));
    if (error) { mSay(`Could not delete: ${error.message}`); return; }
    days = days.filter((x) => x.id !== id);
    mSay(`${d?.name ?? "Category"} deleted.`);
    renderDayButtons();
    renderManage();
  }

  async function moveExercise(exId: string, day: string) {
    const { error } = await withTimeout(
      supabase.from("exercises").update({ day }).eq("id", exId)
    );
    if (error) { mSay(`Could not move: ${error.message}`); return; }
    const e = exercises.find((x) => x.id === exId);
    if (e) e.day = day;
    mSay(`${e?.name ?? "Exercise"} moved to ${day}.`);
    renderManage();
  }

  async function restoreExercise(exId: string) {
    const { error } = await withTimeout(
      supabase.from("exercises").update({ archived: false }).eq("id", exId)
    );
    if (error) { mSay(`Could not restore: ${error.message}`); return; }
    const e = exercises.find((x) => x.id === exId);
    if (e) e.archived = false;
    mSay(`${e?.name ?? "Exercise"} restored.`);
    renderManage();
  }

  // ---------------------------------------------------------- consistency
  // Same block characters the old WakaTime tracker used: light shade for a
  // rest day, medium for a session, full for a long one.
  const keyOf = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

  // Tapping a day lists everything done that day, so several sessions on one
  // date are all reachable instead of only the newest.
  function showDay(key: string, onDay: Workout[]) {
    const withSets = onDay.filter((w) => allSets.some((s) => s.workout_id === w.id));
    if (!withSets.length) { $("cal-day").innerHTML = ""; return; }

    $("cal-day").innerHTML =
      `<p class="muted cal-day-title">${fmtDayKey(key)}</p>` +
      withSets
        .sort((a, b) => +new Date(a.started_at) - +new Date(b.started_at))
        .map((w) => {
          const rows = allSets.filter((s) => s.workout_id === w.id);
          const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
          const time = new Date(w.started_at).toLocaleTimeString(undefined, {
            hour: "numeric", minute: "2-digit",
          });
          return `<button type="button" class="hist-row" data-w="${w.id}">
            <span class="hist-day">${esc(w.day)}</span>
            <span class="hist-meta">${time} · ${plural(rows.length, "set")} · ${vol} vol</span>
          </button>`;
        })
        .join("");

    $("cal-day").querySelectorAll<HTMLButtonElement>("button[data-w]").forEach((b) =>
      b.addEventListener("click", () => openWorkout(b.dataset.w!))
    );
  }

  function stepMonth(delta: number) {
    if (!calMonth) return;
    const next = new Date(calMonth.getFullYear(), calMonth.getMonth() + delta, 1);
    const thisMonth = new Date();
    // Nothing to see in the future.
    if (next > new Date(thisMonth.getFullYear(), thisMonth.getMonth(), 1)) return;
    calMonth = next;
    renderCalendar();
  }

  function renderCalendar() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (!calMonth) calMonth = new Date(today.getFullYear(), today.getMonth(), 1);

    const year = calMonth.getFullYear();
    const month = calMonth.getMonth();

    $("cal-title").textContent = calMonth.toLocaleDateString(undefined, {
      month: "long", year: "numeric",
    });

    // Sets per day, and the workout to open when a day is tapped.
    const counts = new Map<string, number>();
    for (const st of allSets) {
      const k = dayKey(st.performed_at);
      counts.set(k, (counts.get(k) ?? 0) + 1);
    }
    // A day can hold several workouts; keep them all, not just the last.
    const workoutsOn = new Map<string, Workout[]>();
    for (const w of workouts) {
      const k = dayKey(w.started_at);
      if (!workoutsOn.has(k)) workoutsOn.set(k, []);
      workoutsOn.get(k)!.push(w);
    }

    const first = new Date(year, month, 1);
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    // Monday-first, so Sunday (0) becomes 6.
    const lead = (first.getDay() + 6) % 7;

    let html = "";
    for (let i = 0; i < lead; i++) html += '<span class="cal-cell cal-blank"></span>';

    let trained = 0;
    let sets = 0;
    for (let d = 1; d <= daysInMonth; d++) {
      const date = new Date(year, month, d);
      const key = keyOf(date);
      const n = counts.get(key) ?? 0;
      const future = date > today;
      const isToday = keyOf(today) === key;
      const mark = future ? " " : n === 0 ? "░" : n >= 6 ? "█" : "▓";
      if (n > 0) { trained++; sets += n; }

      const onDay = (workoutsOn.get(key) ?? []).filter(
        (w) => allSets.some((x) => x.workout_id === w.id)
      );
      const cls = ["cal-cell"];
      if (n > 0) cls.push("cal-on");
      if (isToday) cls.push("cal-today");
      if (future) cls.push("cal-future");

      // Show the set count rather than a bare block: far more to read at a
      // glance, and it makes a busy month look busy.
      const body = `<span class="cal-d">${d}</span>` +
        (n > 0
          ? `<span class="cal-m">${mark}</span><span class="cal-n">${n}</span>` +
            (onDay.length > 1 ? `<span class="cal-multi">${onDay.length}×</span>` : "")
          : `<span class="cal-m">${mark}</span>`);

      html += onDay.length
        ? `<button type="button" class="${cls.join(" ")}" data-day="${key}">${body}</button>`
        : `<span class="${cls.join(" ")}">${body}</span>`;
    }

    $("cal").innerHTML = html;
    $("cal-note").textContent = trained
      ? `${plural(trained, "day")} · ${plural(sets, "set")} this month`
      : "Nothing logged this month.";

    $("cal").querySelectorAll<HTMLButtonElement>("button[data-day]").forEach((b) =>
      b.addEventListener("click", () => showDay(b.dataset.day!, workoutsOn.get(b.dataset.day!) ?? []))
    );
    $("cal-day").innerHTML = "";

    // Disable forward navigation at the current month.
    const atNow = year === today.getFullYear() && month === today.getMonth();
    (<HTMLButtonElement>$("cal-next")).disabled = atNow;
  }

  // -------------------------------------------------------------- history
  function renderHistory() {
    const done = workouts.filter((w) => w.ended_at);
    if (!done.length) {
      $("history-list").innerHTML = '<p class="muted">No finished workouts yet.</p>';
      return;
    }
    $("history-list").innerHTML = done.map((w) => {
      const rows = allSets.filter((s) => s.workout_id === w.id);
      const vol = Math.round(rows.reduce((t, r) => t + r.weight * r.reps, 0));
      const mins = Math.round((+new Date(w.ended_at!) - +new Date(w.started_at)) / 60000);
      return `<button type="button" class="hist-row" data-w="${w.id}">
        <span class="hist-day">${esc(w.day)}</span>
        <span class="hist-meta">${fmtDate(w.started_at)} · ${plural(rows.length, "set")} · ${vol} vol · ${mins} min</span>
      </button>`;
    }).join("");

    $("history-list").querySelectorAll<HTMLButtonElement>(".hist-row").forEach((b) =>
      b.addEventListener("click", () => openWorkout(b.dataset.w!)));
  }

  function openWorkout(id: string) {
    showSummary(id, "history");
  }

  // -------------------------------------------------------------- progress
  // Everything combined, so you can see whether the whole programme is
  // moving rather than one lift at a time.
  function renderOverall() {
    const metric = (<HTMLSelectElement>$("overall-metric")).value;
    const canvas = <HTMLCanvasElement>$("overall-chart");

    if (!allSets.length) {
      overallChart?.destroy(); overallChart = null;
      canvas.style.display = "none";
      $("overall-msg").textContent = "Nothing logged yet.";
      return;
    }
    canvas.style.display = "";

    // Volume cannot mix units on one axis, so chart the dominant one.
    const kg = allSets.filter((r) => r.unit === "kg").length;
    const unit = kg > allSets.length - kg ? "kg" : "lbs";
    const usable = metric === "volume"
      ? allSets.filter((r) => r.unit === unit)
      : allSets;
    const dropped = metric === "volume" ? allSets.length - usable.length : 0;

    let labels: string[] = [];
    let values: number[] = [];
    let label = "";

    if (metric === "weekly") {
      // Bucket by the Monday that starts each week.
      const byWeek = new Map<string, Set<string>>();
      for (const r of usable) {
        const d = new Date(r.performed_at);
        d.setHours(0, 0, 0, 0);
        d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
        const k = keyOf(d);
        if (!byWeek.has(k)) byWeek.set(k, new Set());
        byWeek.get(k)!.add(dayKey(r.performed_at));
      }
      labels = [...byWeek.keys()].sort();
      values = labels.map((k) => byWeek.get(k)!.size);
      label = "Sessions per week";
      labels = labels.map(fmtDayKey);
    } else {
      const byDay = new Map<string, SetRow[]>();
      for (const r of usable) {
        const k = dayKey(r.performed_at);
        if (!byDay.has(k)) byDay.set(k, []);
        byDay.get(k)!.push(r);
      }
      const keys = [...byDay.keys()].sort();
      values = keys.map((k) => {
        const rs = byDay.get(k)!;
        return metric === "sets"
          ? rs.length
          : Math.round(rs.reduce((t, r) => t + r.weight * r.reps, 0));
      });
      label = metric === "sets" ? "Sets" : `Volume (${unit})`;
      labels = keys.map(fmtDayKey);
    }

    overallChart?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    overallChart = new Chart(canvas, {
      type: metric === "weekly" ? "bar" : "line",
      data: { labels, datasets: [{
        label, data: values, borderColor: accent(),
        backgroundColor: accentFill(0.25), tension: 0.25, pointRadius: 3,
        fill: metric !== "weekly",
      }]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: ink, boxWidth: 12 } } },
        scales: {
          x: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
          y: { beginAtZero: true, ticks: { color: ink, precision: 0 },
               grid: { color: "rgba(128,128,128,.2)" } },
        },
      },
    });

    const days = new Set(allSets.map((r) => dayKey(r.performed_at))).size;
    const totalVol = Math.round(
      allSets.filter((r) => r.unit === unit).reduce((t, r) => t + r.weight * r.reps, 0)
    );
    $("overall-msg").textContent =
      `${plural(days, "session")} · ${plural(allSets.length, "set")} · ${totalVol} total volume (${unit})` +
      (dropped ? ` · ${dropped} set(s) in the other unit not charted` : "");
  }

  function renderProgressPicker() {
    const sel = <HTMLSelectElement>$("progress-exercise");
    const keep = sel.value;
    const withData = exercises.filter((e) => allSets.some((s) => s.exercise_id === e.id));
    sel.innerHTML = '<option value="">Choose an exercise…</option>' +
      dayNames().map((d) => {
        const inDay = withData.filter((e) => e.day === d);
        if (!inDay.length) return "";
        return `<optgroup label="${d}">${inDay
          .map((e) => `<option value="${e.id}">${esc(e.name)}</option>`).join("")}</optgroup>`;
      }).join("");
    if (keep) sel.value = keep;
  }

  function renderProgress() {
    const exId = (<HTMLSelectElement>$("progress-exercise")).value;
    const metric = (<HTMLSelectElement>$("progress-metric")).value;
    const canvas = <HTMLCanvasElement>$("progress-chart");

    if (!exId) {
      progressChart?.destroy(); progressChart = null;
      canvas.style.display = "none";
      $("progress-msg").textContent = "Pick an exercise.";
      $("progress-table").innerHTML = "";
      return;
    }

    const rows = allSets.filter((s) => s.exercise_id === exId);
    if (!rows.length) {
      progressChart?.destroy(); progressChart = null;
      canvas.style.display = "none";
      $("progress-msg").textContent = "Nothing logged for this exercise yet.";
      $("progress-table").innerHTML = "";
      return;
    }
    canvas.style.display = "";

    const kg = rows.filter((r) => r.unit === "kg").length;
    const unit = kg > rows.length - kg ? "kg" : "lbs";
    const inUnit = rows.filter((r) => r.unit === unit);
    const dropped = rows.length - inUnit.length;

    const byDay = new Map<string, SetRow[]>();
    for (const r of inUnit) {
      const k = dayKey(r.performed_at);
      if (!byDay.has(k)) byDay.set(k, []);
      byDay.get(k)!.push(r);
    }
    const labels = [...byDay.keys()].sort();
    const values = labels.map((d) => {
      const rs = byDay.get(d)!;
      if (metric === "volume") return Math.round(rs.reduce((t, r) => t + r.weight * r.reps, 0));
      if (metric === "top") return Math.max(...rs.map((r) => r.weight));
      return Math.round(Math.max(...rs.map((r) => e1rm(r.weight, r.reps))));
    });
    const label = metric === "volume" ? `Volume (${unit})`
      : metric === "top" ? `Heaviest set (${unit})` : `Est. 1RM (${unit})`;

    progressChart?.destroy();
    const ink = getComputedStyle(document.documentElement).color;
    progressChart = new Chart(canvas, {
      type: "line",
      data: { labels, datasets: [{
        label, data: values, borderColor: accent(),
        backgroundColor: accentFill(0.15), tension: 0.25, pointRadius: 3, fill: true,
      }]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: ink, boxWidth: 12 } } },
        scales: {
          x: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
          y: { ticks: { color: ink }, grid: { color: "rgba(128,128,128,.2)" } },
        },
      },
    });

    $("progress-msg").textContent = dropped
      ? `${dropped} set(s) logged in the other unit are not shown.` : "";

    const recent = [...byDay.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1)).slice(0, 10);
    $("progress-table").innerHTML = recent.map(([d, rs]) =>
      `<div class="hist-row static">
        <span class="hist-day">${fmtDayKey(d)}</span>
        <span class="hist-meta">${rs.sort((a, b) => a.set_number - b.set_number)
          .map((r) => `${r.weight}×${r.reps}`).join(", ")}</span>
      </div>`).join("");
  }
</script>
